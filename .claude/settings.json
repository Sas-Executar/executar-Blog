{
  "enabledPlugins": {
    "engineering@knowledge-work-plugins": true,
    "design@knowledge-work-plugins": true,
    "security-guidance@knowledge-work-plugins": true,
    "copiloto-operacional@executar-blog": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    },
    "executar-blog": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { [ -d node_modules ] || npm ci --no-audit --no-fund; }"
          }
        ]
      }
    ]
  }
}
