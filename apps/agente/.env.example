# Gerado em .env pelo scripts/setup-env.mjs (ADR-009). Nunca versionar o .env.
# A chave fica só no Worker; o container recebe apenas um placeholder.
ANTHROPIC_API_KEY=
# Opcional: URL do AI Gateway para spend limit/logs, ex.:
# https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/anthropic
AI_GATEWAY_URL=
