/**
 * Worker do agente (ADR-008). Derivado de cloudflare/sandbox-sdk/examples/claude-code.
 * Sem rota pública: o blog chama por service binding.
 */
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "executar-agente",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-21",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	// Não secreto. Preencher com a URL do AI Gateway para spend limit/logs (ADR-008).
	"vars": { "AI_GATEWAY_URL": "" },
	"secrets": { "required": ["ANTHROPIC_API_KEY"] },
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile",
			"image_build_context": "../..",
			"instance_type": "basic",
			"max_instances": 2
		}
	],
	"durable_objects": {
		"bindings": [{ "class_name": "Sandbox", "name": "Sandbox" }]
	},
	"migrations": [{ "new_sqlite_classes": ["Sandbox"], "tag": "v1" }]
}
