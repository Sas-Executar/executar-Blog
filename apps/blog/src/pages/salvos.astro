---
// Salvos (HF04): lista local do navegador; remover exclui; lista vazia orienta a descoberta.
// Lista simples do vocabulário editorial (ADR-019): sem card, filete entre itens.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage frontmatter={{ title: 'Salvos', description: 'Artigos que você salvou para ler depois.', template: 'splash', pagefind: false }}>
	<div class="salvos faixa not-content">
		<p class="deck">Os artigos salvos ficam guardados neste navegador, sem conta e sem prazo para expirar.</p>
		<p class="sr-only" role="status" aria-live="polite" data-estado></p>
		<ul class="lista-simples" data-lista></ul>
		<div class="vazio" data-vazio hidden>
			<p><strong>Você ainda não salvou nenhum artigo.</strong></p>
			<p>Use o botão Salvar no topo de qualquer artigo para guardá-lo aqui.</p>
			<a href="/explorar/" class="edit-btn">Explorar artigos</a>
		</div>
	</div>
</StarlightPage>

<script>
	import { lerSalvos, removerSalvo } from '../lib/salvos';

	function render() {
		const raiz = document.querySelector<HTMLElement>('.salvos');
		if (!raiz) return;
		const lista = raiz.querySelector<HTMLUListElement>('[data-lista]')!;
		const vazio = raiz.querySelector<HTMLElement>('[data-vazio]')!;
		const estado = raiz.querySelector<HTMLElement>('[data-estado]')!;
		const salvos = lerSalvos();
		lista.replaceChildren();
		vazio.hidden = salvos.length > 0;
		for (const s of salvos) {
			const li = document.createElement('li');
			li.innerHTML = `<div><p class="eyebrow"></p><a></a><p class="deck-item"></p><span class="tempo"></span></div><button type="button" class="edit-btn">Remover</button>`;
			li.querySelector('.eyebrow')!.textContent = s.categoria;
			const a = li.querySelector('a')!;
			a.href = s.url;
			a.textContent = s.titulo;
			li.querySelector('.deck-item')!.textContent = s.resumo;
			li.querySelector('.tempo')!.textContent = `${s.minutos} min de leitura`;
			const botao = li.querySelector('button')!;
			botao.setAttribute('aria-label', `Remover "${s.titulo}" dos salvos`);
			botao.addEventListener('click', () => {
				if (!removerSalvo(s.url)) {
					estado.textContent = 'Não foi possível remover. Verifique se o armazenamento do navegador está bloqueado.';
					return;
				}
				render();
				estado.textContent = `"${s.titulo}" removido dos salvos.`;
				(document.querySelector<HTMLElement>('.salvos li button') ?? document.querySelector<HTMLElement>('.salvos [data-vazio] a'))?.focus();
			});
			lista.append(li);
		}
	}
	render();
	document.addEventListener('astro:page-load', render);
</script>

<style>
	.salvos .deck {
		max-width: 640px;
	}
	.salvos .vazio {
		margin-top: 32px;
		padding-top: 24px;
		border-top: 1px solid var(--line);
	}
	.salvos .vazio[hidden] {
		display: none;
	}
	.salvos .vazio p {
		margin: 0 0 8px;
	}
	.salvos .lista-simples > li > div {
		display: grid;
		gap: 6px;
		min-width: 0;
		flex: 1;
	}
	.salvos .tempo {
		font: 12px var(--mono);
		color: var(--muted);
	}
	.salvos .deck-item {
		margin: 0;
		color: var(--muted);
	}
</style>
