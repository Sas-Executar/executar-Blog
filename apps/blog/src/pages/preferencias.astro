---
// Preferências (HF05): cada opção mostra o estado atual e muda a experiência na hora, em todas as
// páginas (aplicada cedo pelo script de Head.astro, para não piscar). Vocabulário editorial
// (ADR-019): filetes finos, sem cartão elevado.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Icone from '../components/Icone.astro';

const opcoes = [
	{
		chave: 'tema',
		icone: 'tema',
		rotulo: 'Tema',
		ajuda: 'Automático segue o modo claro/escuro do seu sistema.',
		valores: [
			['auto', 'Automático'],
			['light', 'Claro'],
			['dark', 'Escuro'],
		],
	},
	{
		chave: 'texto',
		icone: 'texto',
		rotulo: 'Tamanho do texto',
		ajuda: 'Aumenta o texto dos artigos e da interface.',
		valores: [
			['padrao', 'Padrão'],
			['grande', 'Grande'],
			['maior', 'Maior'],
		],
	},
	{
		chave: 'movimento',
		icone: 'movimento',
		rotulo: 'Movimento',
		ajuda: 'Reduzir desliga animações e transições.',
		valores: [
			['padrao', 'Padrão'],
			['reduzido', 'Reduzido'],
		],
	},
] as const;
const atalhos = [
	{ href: '/salvos/', rotulo: 'Salvos', icone: 'salvos' },
	{ href: '/explorar/', rotulo: 'Explorar artigos', icone: 'explorar' },
	{ href: '/buscar/', rotulo: 'Buscar', icone: 'buscar' },
] as const;
const sobre = [
	{ href: '/perguntar/', rotulo: 'Pergunte aos artigos', icone: 'documento' },
	{ href: '/guia-de-estilo/', rotulo: 'Guia de estilo', icone: 'estilo', valor: 'ADR-019' },
] as const;
---

<StarlightPage frontmatter={{ title: 'Preferências', description: 'Ajuste tema, tamanho do texto e movimento.', template: 'splash', pagefind: false }}>
	<div class="preferencias faixa not-content">
		<p class="deck">As escolhas ficam guardadas neste navegador e valem para todas as páginas.</p>

		<div class="grupo-secao">
			<p class="grupo-secao__rotulo">Aparência</p>
			{
				opcoes.map((o) => (
					<div class="opcao" data-preferencia={o.chave}>
						<p class="opcao__cabecalho">
							<span class="opcao__icone">
								<Icone nome={o.icone} />
							</span>
							{o.rotulo}
						</p>
						<p class="opcao__ajuda">{o.ajuda}</p>
						<div class="opcao__controle">
							<div class="segmentado">
								{o.valores.map(([valor, nome]) => (
									<label>
										<input type="radio" name={o.chave} value={valor} />
										<span>{nome}</span>
									</label>
								))}
							</div>
							<p class="opcao__atual" data-atual />
						</div>
					</div>
				))
			}
		</div>

		<div class="grupo-secao">
			<p class="grupo-secao__rotulo">Sua leitura</p>
			{
				atalhos.map((a) => (
					<a class="grupo-linha" href={a.href}>
						<span class="grupo-linha__icone">
							<Icone nome={a.icone} />
						</span>
						<span>{a.rotulo}</span>
					</a>
				))
			}
		</div>

		<div class="grupo-secao">
			<p class="grupo-secao__rotulo">Sobre</p>
			{
				sobre.map((a) => (
					<a class="grupo-linha" href={a.href}>
						<span class="grupo-linha__icone">
							<Icone nome={a.icone} />
						</span>
						<span>{a.rotulo}</span>
						{'valor' in a && <span class="grupo-linha__valor">{a.valor}</span>}
					</a>
				))
			}
		</div>
		<p class="sr-only" role="status" aria-live="polite" data-estado></p>
	</div>
</StarlightPage>

<script>
	import { anunciar } from '../lib/salvos';

	const CHAVES = { tema: 'starlight-theme', texto: 'executar:texto', movimento: 'executar:movimento' } as const;
	type Chave = keyof typeof CHAVES;

	function ler(chave: Chave) {
		try {
			return localStorage.getItem(CHAVES[chave]) || (chave === 'tema' ? 'auto' : 'padrao');
		} catch {
			return chave === 'tema' ? 'auto' : 'padrao';
		}
	}

	function aplicar(chave: Chave, valor: string) {
		const html = document.documentElement;
		try {
			// O Starlight guarda '' para "automático".
			localStorage.setItem(CHAVES[chave], chave === 'tema' && valor === 'auto' ? '' : valor);
		} catch {
			/* armazenamento bloqueado: a escolha vale só para esta página */
		}
		if (chave === 'tema') {
			const escuro = valor === 'dark' || (valor === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
			html.dataset.theme = escuro ? 'dark' : 'light';
		} else if (chave === 'texto') {
			html.dataset.texto = valor;
		} else {
			html.dataset.movimento = valor;
		}
	}

	function iniciar() {
		document.querySelectorAll<HTMLElement>('[data-preferencia]').forEach((grupo) => {
			const chave = grupo.dataset.preferencia as Chave;
			const atual = grupo.querySelector<HTMLElement>('[data-atual]')!;
			const pintar = () => {
				const valor = ler(chave);
				const radio = grupo.querySelector<HTMLInputElement>(`input[value="${valor}"]`);
				if (radio) radio.checked = true;
				atual.textContent = `Atual: ${radio?.nextElementSibling?.textContent ?? valor}`;
			};
			pintar();
			grupo.addEventListener('change', (e) => {
				const valor = (e.target as HTMLInputElement).value;
				aplicar(chave, valor);
				pintar();
				anunciar(`${grupo.querySelector('.opcao__cabecalho')!.textContent}: ${atual.textContent!.replace('Atual: ', '')}.`);
			});
		});
	}
	iniciar();
	document.addEventListener('astro:page-load', iniciar);
</script>

<style>
	.preferencias .deck {
		max-width: 640px;
	}
</style>
