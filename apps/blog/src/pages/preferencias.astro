---
// Preferências (HF05): cada opção mostra o estado atual e muda a experiência na hora, em todas as
// páginas (aplicada cedo pelo script de Head.astro, para não piscar). Layout em listas agrupadas,
// no padrão de Ajustes do iOS (ADR-017, SOT-REF-003).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Icone from '../components/Icone.astro';

const opcoes = [
	{
		chave: 'tema',
		icone: 'tema',
		rotulo: 'Tema',
		ajuda: 'Automático segue o modo claro/escuro do seu sistema.',
		valores: [
			['auto', 'Automático'],
			['light', 'Claro'],
			['dark', 'Escuro'],
		],
	},
	{
		chave: 'texto',
		icone: 'texto',
		rotulo: 'Tamanho do texto',
		ajuda: 'Aumenta o texto dos artigos e da interface.',
		valores: [
			['padrao', 'Padrão'],
			['grande', 'Grande'],
			['maior', 'Maior'],
		],
	},
	{
		chave: 'movimento',
		icone: 'movimento',
		rotulo: 'Movimento',
		ajuda: 'Reduzir desliga animações e transições.',
		valores: [
			['padrao', 'Padrão'],
			['reduzido', 'Reduzido'],
		],
	},
] as const;
const atalhos = [
	{ href: '/salvos/', rotulo: 'Salvos', icone: 'salvos' },
	{ href: '/explorar/', rotulo: 'Explorar artigos', icone: 'explorar' },
	{ href: '/buscar/', rotulo: 'Buscar', icone: 'buscar' },
] as const;
const sobre = [
	{ href: '/perguntar/', rotulo: 'Pergunte aos artigos', icone: 'documento' },
	{ href: '/guia-de-estilo/', rotulo: 'Guia de estilo', icone: 'estilo', valor: 'ADR-017' },
] as const;
---

<StarlightPage frontmatter={{ title: 'Preferências', description: 'Ajuste tema, tamanho do texto e movimento.', template: 'splash', pagefind: false }}>
	<div class="preferencias not-content mx-auto max-w-read">
		<p class="intro m-0 text-lead text-pretty text-muted">As escolhas ficam guardadas neste navegador e valem para todas as páginas.</p>

		<p class="grupo-rotulo" id="grupo-aparencia">Aparência</p>
		<ul class="grupo" aria-labelledby="grupo-aparencia">
			{
				opcoes.map((o) => (
					<li>
						<fieldset data-preferencia={o.chave} class="m-0 border-0 px-5 py-4">
							<legend class="float-left m-0 flex w-full items-center gap-4 p-0 text-[1.0625rem] font-medium text-ink">
								<span class="grupo__icone"><Icone nome={o.icone} /></span>
								{o.rotulo}
							</legend>
							<p class="clear-both m-0 pt-1 pb-3 pl-10 text-label text-muted">{o.ajuda}</p>
							<div class="sm:pl-10">
								<div class="segmentado flex w-full flex-nowrap [&_label]:flex-1 [&_label]:justify-center [&_label]:px-2">
									{o.valores.map(([valor, nome]) => (
										<label>
											<input type="radio" name={o.chave} value={valor} />
											<span>{nome}</span>
										</label>
									))}
								</div>
								<p class="atual mt-2 mb-0 font-mono text-xs tracking-wide text-muted uppercase" data-atual />
							</div>
						</fieldset>
					</li>
				))
			}
		</ul>

		<p class="grupo-rotulo" id="grupo-leitura">Sua leitura</p>
		<ul class="grupo" aria-labelledby="grupo-leitura">
			{
				atalhos.map((a) => (
					<li>
						<a class="grupo__linha" href={a.href}>
							<span class="grupo__icone"><Icone nome={a.icone} /></span>
							<span>{a.rotulo}</span>
						</a>
					</li>
				))
			}
		</ul>

		<p class="grupo-rotulo" id="grupo-sobre">Sobre</p>
		<ul class="grupo" aria-labelledby="grupo-sobre">
			{
				sobre.map((a) => (
					<li>
						<a class="grupo__linha" href={a.href}>
							<span class="grupo__icone"><Icone nome={a.icone} /></span>
							<span>{a.rotulo}</span>
							{'valor' in a && <span class="grupo__valor font-mono text-xs">{a.valor}</span>}
						</a>
					</li>
				))
			}
		</ul>
		<p class="sr-only" role="status" aria-live="polite" data-estado></p>
	</div>
</StarlightPage>

<script>
	import { anunciar } from '../lib/salvos';

	const CHAVES = { tema: 'starlight-theme', texto: 'executar:texto', movimento: 'executar:movimento' } as const;
	type Chave = keyof typeof CHAVES;

	function ler(chave: Chave) {
		try {
			return localStorage.getItem(CHAVES[chave]) || (chave === 'tema' ? 'auto' : 'padrao');
		} catch {
			return chave === 'tema' ? 'auto' : 'padrao';
		}
	}

	function aplicar(chave: Chave, valor: string) {
		const html = document.documentElement;
		try {
			// O Starlight guarda '' para "automático".
			localStorage.setItem(CHAVES[chave], chave === 'tema' && valor === 'auto' ? '' : valor);
		} catch {
			/* armazenamento bloqueado: a escolha vale só para esta página */
		}
		if (chave === 'tema') {
			const escuro = valor === 'dark' || (valor === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
			html.dataset.theme = escuro ? 'dark' : 'light';
		} else if (chave === 'texto') {
			html.dataset.texto = valor;
		} else {
			html.dataset.movimento = valor;
		}
	}

	function iniciar() {
		document.querySelectorAll<HTMLFieldSetElement>('[data-preferencia]').forEach((grupo) => {
			const chave = grupo.dataset.preferencia as Chave;
			const atual = grupo.querySelector<HTMLElement>('[data-atual]')!;
			const pintar = () => {
				const valor = ler(chave);
				const radio = grupo.querySelector<HTMLInputElement>(`input[value="${valor}"]`);
				if (radio) radio.checked = true;
				atual.textContent = `Atual: ${radio?.nextElementSibling?.textContent ?? valor}`;
			};
			pintar();
			grupo.addEventListener('change', (e) => {
				const valor = (e.target as HTMLInputElement).value;
				aplicar(chave, valor);
				pintar();
				anunciar(`${grupo.querySelector('legend')!.textContent}: ${atual.textContent!.replace('Atual: ', '')}.`);
			});
		});
	}
	iniciar();
	document.addEventListener('astro:page-load', iniciar);
</script>
