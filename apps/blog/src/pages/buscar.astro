---
// Busca (HF03): índice do Pagefind (gerado no build pelo Starlight), resultados em lista simples e
// estado vazio que convida a reformular (ADR-019: vocabulário da referência editorial).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Icone from '../components/Icone.astro';
import { artigos } from '../lib/artigos';

const sugestoes = (await artigos()).map((a) => a.titulo);
---

<StarlightPage frontmatter={{ title: 'Buscar', description: 'Busque nos artigos do Risco Cognitivo.', template: 'splash', pagefind: false }}>
	<div class="buscar faixa not-content">
		<form class="campo-busca" role="search" data-form>
			<label class="sr-only" for="q">Buscar nos artigos</label>
			<Icone nome="buscar" />
			<input id="q" name="q" type="search" placeholder="Ex.: atenção, notificações, checklist…" autocomplete="off" />
			<button type="submit" class="edit-btn">Buscar</button>
		</form>
		<p class="estado-busca" role="status" aria-live="polite" data-estado>Digite um termo e pressione Buscar.</p>
		<ol class="resultados" data-resultados></ol>
		<div class="vazio" data-vazio hidden>
			<p>Nenhum resultado para "<strong data-termo></strong>".</p>
			<p>Tente outras palavras, um termo mais amplo ou um destes artigos:</p>
			<ul class="sugestoes">
				{sugestoes.map((s) => <li><button type="button" class="filtro-chip" data-sugestao={s}>{s}</button></li>)}
			</ul>
		</div>
	</div>
</StarlightPage>

<script>
	interface ResultadoPagefind {
		url: string;
		excerpt: string;
		meta: { title?: string };
	}

	async function carregarPagefind() {
		const caminho = '/pagefind/pagefind.js';
		return import(/* @vite-ignore */ caminho) as Promise<{ search: (q: string) => Promise<{ results: { data: () => Promise<ResultadoPagefind> }[] }> }>;
	}

	function iniciar() {
		const raiz = document.querySelector<HTMLElement>('.buscar');
		if (!raiz || raiz.dataset.pronto) return;
		raiz.dataset.pronto = 'true';
		const form = raiz.querySelector<HTMLFormElement>('[data-form]')!;
		const campo = form.querySelector<HTMLInputElement>('input')!;
		const estado = raiz.querySelector<HTMLElement>('[data-estado]')!;
		const lista = raiz.querySelector<HTMLOListElement>('[data-resultados]')!;
		const vazio = raiz.querySelector<HTMLElement>('[data-vazio]')!;

		async function buscar(q: string) {
			lista.replaceChildren();
			vazio.hidden = true;
			if (!q.trim()) {
				estado.textContent = 'Digite um termo e pressione Buscar.';
				return;
			}
			estado.textContent = 'Buscando…';
			try {
				const pagefind = await carregarPagefind();
				const busca = await pagefind.search(q);
				const dados = (await Promise.all(busca.results.slice(0, 20).map((r) => r.data()))).filter((d) => d.url.includes('/blog/'));
				if (dados.length === 0) {
					vazio.querySelector('[data-termo]')!.textContent = q;
					vazio.hidden = false;
					estado.textContent = `Nenhum resultado para "${q}".`;
					return;
				}
				estado.textContent = dados.length === 1 ? `1 resultado para "${q}".` : `${dados.length} resultados para "${q}".`;
				for (const d of dados) {
					const li = document.createElement('li');
					const a = document.createElement('a');
					a.href = d.url;
					a.textContent = d.meta.title ?? d.url;
					const p = document.createElement('p');
					p.innerHTML = d.excerpt; // HTML do próprio índice do Pagefind (<mark> nos termos)
					li.append(a, p);
					lista.append(li);
				}
			} catch {
				estado.textContent = 'A busca não está disponível agora. Tente de novo em instantes ou use Explorar.';
			}
		}

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const q = campo.value.trim();
			history.replaceState(null, '', q ? `?q=${encodeURIComponent(q)}` : location.pathname);
			void buscar(q);
		});
		vazio.addEventListener('click', (e) => {
			const alvo = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-sugestao]');
			if (!alvo) return;
			campo.value = alvo.dataset.sugestao!;
			form.requestSubmit();
		});
		const inicial = new URLSearchParams(location.search).get('q') ?? '';
		campo.value = inicial;
		if (inicial) void buscar(inicial);
		else campo.focus();
	}
	iniciar();
	document.addEventListener('astro:page-load', iniciar);
</script>

<style>
	.buscar .campo-busca {
		max-width: 40rem;
	}
	.buscar .vazio {
		margin-top: 24px;
		padding-top: 24px;
		border-top: 1px solid var(--line);
	}
	.buscar .vazio[hidden] {
		display: none;
	}
	.buscar .vazio p {
		margin: 0 0 8px;
		color: var(--ink);
	}
</style>
