---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Perguntar from '../components/Perguntar.astro';
---

<StarlightPage frontmatter={{ title: 'Pergunte aos artigos', description: 'Faça uma pergunta e o assistente responde usando apenas os artigos do blog, com as fontes.', template: 'splash' }}>
	<div class="faixa not-content">
		<p class="deck" style="max-width:640px">O assistente lê os artigos do Risco Cognitivo e responde com base neles, sempre citando as fontes. Ele não usa informação externa e não guarda sua pergunta.</p>
		<div style="margin-top:32px">
			<Perguntar />
		</div>
	</div>
</StarlightPage>
