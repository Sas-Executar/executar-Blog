---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ListaArtigos from '../../../components/ListaArtigos.astro';
import { artigos, categorias } from '../../../lib/artigos';

export async function getStaticPaths() {
	return (await categorias()).map((c) => ({ params: { slug: c.slug }, props: { nome: c.nome } }));
}

const { slug } = Astro.params;
const { nome } = Astro.props;
const lista = (await artigos()).filter((a) => a.categoriaSlug === slug);
---

<StarlightPage frontmatter={{ title: nome, description: `Artigos da categoria ${nome}.`, template: 'splash' }}>
	<div class="faixa not-content">
		<nav class="crumb trilha" aria-label="Trilha" style="padding:0 0 20px;border-bottom:1px solid var(--line)"><a href="/blog/">Blog</a> &nbsp;/&nbsp; <b>{nome}</b></nav>
		<p class="contagem" style="margin-top:24px">{lista.length} {lista.length === 1 ? 'artigo' : 'artigos'} nesta categoria.</p>
		<ListaArtigos lista={lista} vazio="Esta categoria ainda não tem artigos." />
	</div>
</StarlightPage>
