---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ListaArtigos from '../../components/ListaArtigos.astro';
import { artigos } from '../../lib/artigos';

const lista = await artigos();
---

<StarlightPage frontmatter={{ title: 'Blog', description: 'Todos os artigos do Risco Cognitivo, na ordem de leitura recomendada.', template: 'splash' }}>
	<div class="faixa not-content">
		<p class="deck" style="max-width:640px">Todos os artigos, na ordem de leitura recomendada: do problema à decisão.</p>
		<div style="margin-top:32px">
			<ListaArtigos lista={lista} />
		</div>
	</div>
</StarlightPage>
