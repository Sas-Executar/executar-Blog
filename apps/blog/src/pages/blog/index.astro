---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ListaArtigos from '../../components/ListaArtigos.astro';
import { artigos } from '../../lib/artigos';

const lista = await artigos();
---

<StarlightPage frontmatter={{ title: 'Blog', description: 'Todos os artigos do EXECUTAR, na ordem de leitura recomendada.', template: 'splash' }}>
	<div class="pagina-larga not-content">
		<p class="intro mb-10 max-w-2xl text-lead text-pretty text-muted">Todos os artigos, na ordem de leitura recomendada: do problema à decisão.</p>
		<ListaArtigos lista={lista} />
	</div>
</StarlightPage>
