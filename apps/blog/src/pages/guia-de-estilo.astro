										<p class="m-0 font-display text-title leading-tight font-bold tracking-tight text-ink">Externalização cognitiva</p>
										<span class="botao botao--quieto botao--p -ml-3 justify-self-start" aria-hidden="true">Ler agora <Icone nome="seta" tamanho={16} /></span>
									</div>
								)}
							</div>
							<p class="m-0 text-label text-muted">{texto}</p>
						</li>
					))
				}
			</ol>
		</section>
	</div>
</StarlightPage>

