				<li class="flex items-baseline gap-4"><span class="font-mono text-xs font-bold text-link">02</span><span class="text-ink">Externalização cognitiva</span></li>
				<li class="flex items-baseline gap-4"><span class="font-mono text-xs font-bold text-link">03</span><span class="text-ink">Fatores de riscos cognitivos</span></li>
			</ul>
