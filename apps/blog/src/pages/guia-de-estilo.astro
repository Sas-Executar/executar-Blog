										<span class="categoria-chip">P1 · Problemas</span>
										<span class="categoria-chip">C3 · Decisão</span>
									</div>
								)}
								{n === '03' && (
									<>
										<span class="crumb" aria-hidden="true">Blog / Pessoa e cognição</span>
