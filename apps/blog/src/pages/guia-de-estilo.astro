---
// Guia de estilo (ADR-019): documentação viva do design system — agora no mesmo vocabulário da
// referência editorial usada no resto do blog (risco-cognitivo.css + integracao.css), não mais nos
// componentes ui/* do ADR-017 (retirados: nada além desta página os usava). As cores são lidas de
// @executar/theme/cores.css no build, o contraste vem do mesmo verificador do HIG
// (scripts/check-contrast.mjs) e os blocos editoriais passam pelo mesmo pipeline de Markdown do
// vault (@executar/editorial-renderer) e pelo Expressive Code do blog.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import { renderMarkdown } from '@executar/editorial-renderer';
import coresCss from '@executar/theme/cores.css?raw';
import { PAIRS, contrast, parseModes } from '../../../../scripts/check-contrast.mjs';
import CategoryPill from '../components/CategoryPill.astro';
import Icone from '../components/Icone.astro';
import PostCard from '../components/PostCard.astro';
import { artigos } from '../lib/artigos';
import { indice } from '../vault.mjs';

const modos = parseModes(coresCss);
const cores = [
	{ token: 'paper', real: 'background', nome: 'Papel', papel: 'Fundo da página: off-white neutro.' },
	{ token: 'card-bg', real: 'surface', nome: 'Superfície', papel: 'Callouts, blocos mono, campos.' },
	{ token: 'ink', real: 'ink', nome: 'Tinta', papel: 'Títulos e ênfase.' },
	{ token: 'muted', real: 'muted', nome: 'Secundário', papel: 'Resumos, metadados, ajuda.' },
	{ token: 'line-strong', real: 'border', nome: 'Filete', papel: 'Divisores fortes e bordas.' },
	{ token: 'line', real: 'border-soft', nome: 'Filete suave', papel: 'Divisores entre itens.' },
	{ token: 'soft', real: 'code-background', nome: 'Código', papel: 'Fundo de controles e código.' },
	{ token: 'brand', real: 'accent', nome: 'Azul', papel: 'Único acento: ação, link, foco.' },
	{ token: 'brand-dark', real: 'brand-text', nome: 'Azul escuro', papel: 'Rótulos e selos.' },
	{ token: 'brand-soft', real: 'brand-soft', nome: 'Azul claro', papel: 'Destaques suaves e barras de título.' },
];
const semanticas = [
	{ fundo: 'success-soft', texto: 'success-text', nome: 'Sucesso' },
	{ fundo: 'warning-soft', texto: 'warning-text', nome: 'Aviso' },
	{ fundo: 'error-soft', texto: 'error-text', nome: 'Erro' },
];
const pares = PAIRS.map(([fg, bg]) => ({
	fg,
	bg,
	claro: contrast(modos.claro[fg], modos.claro[bg]),
	escuro: contrast(modos.escuro[fg], modos.escuro[bg]),
}));

const tipos = [
	{ nome: 'Hero H1', classe: 'guia-tipo--hero', uso: 'Título de artigo', exemplo: 'Execução com clareza' },
	{ nome: 'Título de seção', classe: 'guia-tipo--h2', uso: 'H2 do artigo', exemplo: 'O custo da troca de tarefa' },
	{ nome: 'Deck', classe: 'guia-tipo--deck', uso: 'Subtítulo, introdução', exemplo: 'Artigos sobre atenção, processos e o sistema ao redor de quem executa.' },
	{ nome: 'Corpo', classe: 'guia-tipo--corpo', uso: 'Texto corrido do artigo (19px)', exemplo: 'O texto corrido usa 19px, entrelinha 1,7 e tinta quase preta sobre papel off-white.' },
	{ nome: 'Pullquote', classe: 'guia-tipo--pull', uso: 'Citação em destaque', exemplo: '“Clareza é uma forma de respeito pelo tempo de quem lê.”' },
	{ nome: 'Byline / rótulo', classe: 'guia-tipo--rotulo', uso: 'Autoria, seção, callout', exemplo: 'Equipe EXECUTAR · 07 min' },
	{ nome: 'Eyebrow', classe: 'guia-tipo--eyebrow', uso: 'Categoria, "em destaque"', exemplo: 'Em destaque' },
	{ nome: 'Mono', classe: 'guia-tipo--mono', uso: 'Terminal, número, metadado', exemplo: '07 min · 2026-09-26' },
];
const raios = [
	{ nome: 'radius', valor: 'var(--radius) · 5px', uso: 'Botão, chip, tag' },
	{ nome: 'card-radius', valor: 'var(--card-radius) · 16px', uso: 'Blocos mono, superfícies' },
	{ nome: 'callout-radius', valor: 'var(--callout-radius) · 14px', uso: 'Callouts (biblioteca V9)' },
];

const exemploArtigo = (await artigos())[0];

const md = async (texto: string) => (await renderMarkdown(`---\ntitle: Guia\n---\n${texto}`, { indice })).html;
const editorial = await md(`> [!note] Nota
> Um aviso neutro: ícone circular, cartão arredondado e texto — a biblioteca de callouts da referência (camada V9).

> [!summary] Frase-síntese
> O resumo do artigo em uma frase, com o peso de um lead — o texto fala mais alto que a moldura.

> [!attention]
> **Ponto de atenção.** Esse callout fica de fora da biblioteca com cartão: só filete, igual à referência.

> [!success] Aprovado
> Critério atendido com evidência.

> [!danger] Risco alto
> Use com parcimônia: só o ícone e o rótulo mudam para a cor semântica.

> [!decision] Decisão
> 1. **Qual é o problema real?** Separar sintoma de causa antes de agir.
> 2. **Quem decide?** O dono do processo, com os dados na mesa.
> 3. **Qual o próximo passo?** Uma ação pequena, verificável em uma semana.

1. Listas numeradas usam marcador mono em azul.
2. O ritmo entre itens é constante.

> Citações e destaques viram pullquote: filete azul à esquerda, filetes finos em cima e embaixo.

Texto com ==destaque== e uma #tag no meio da frase.

\`\`\`ascii
ENTRADA ──▶ EXPLORAÇÃO ──▶ LEITURA ──▶ DECISÃO
                               │
                               ▼
                          PRÓXIMA AÇÃO
\`\`\`

:::steps
1. Passos numerados usam o mesmo número mono do sumário.
2. O contorno é fino; o preenchimento, nenhum.
:::
`);
const decisaoStoryboard = await md(`> [!decision] Decisão
> 1. **Vale aplicar agora?** Sim, se o custo da troca de tarefa aparece toda semana.
> 2. **Qual o primeiro teste?** Um bloco de foco de 50 minutos por dia.`);

const secoes = [
	['logo', 'Logo'],
	['cores', 'Cores'],
	['tipografia', 'Tipografia'],
	['espaco', 'Espaço, raio e linhas'],
	['layout', 'Layout e breakpoints'],
	['botoes', 'Botões'],
	['controles', 'Controles de formulário'],
	['navegacao', 'Navegação'],
	['cartoes', 'Cartões e listas'],
	['selos', 'Selos e status'],
	['editorial', 'Componentes editoriais'],
	['mood-board', 'Mood board'],
	['storyboard', 'Storyboard'],
];
const quadros = [
	['01', 'Entrada', 'O leitor chega pela Hoje: uma promessa clara e uma busca.'],
	['02', 'Exploração', 'Categorias em chip estreitam o assunto sem trocar de página.'],
	['03', 'Leitura', 'Trilha, eyebrow, título grande e deck: a tipografia conduz.'],
	['04', 'Interação', 'Salvar e copiar link: ações discretas, mesma anatomia do callout.'],
	['05', 'Decisão', 'O bloco de decisão transforma leitura em escolha.'],
	['06', 'Feedback', 'O sistema confirma com um estado curto, sem interromper.'],
	['07', 'Próxima ação', 'Continue lendo ou pergunte aos artigos.'],
];
---

<StarlightPage frontmatter={{ title: 'Guia de estilo', description: 'Design system editorial do EXECUTAR: fundações, componentes, mood board e storyboard.', template: 'splash', pagefind: false }}>
	<div class="guia faixa">
		<header class="guia__cabecalho not-content">
			<p class="secao-rotulo">Design system · ADR-019</p>
			<h1>Tipografia primeiro. Azul como único acento.</h1>
			<p class="guia__deck">
				Documentação viva do sistema visual do EXECUTAR — agora a própria folha da referência
				editorial, não uma tradução dela. Papel off-white, tinta quase preta, filetes finos e muito
				espaço negativo. Cada exemplo é o componente real, com as classes reais — mude o tema no
				topo para ver o modo escuro.
			</p>
			<dl class="guia__meta">
				<div><dt>Fonte</dt><dd>Inter + mono do sistema</dd></div>
				<div><dt>Fonte visual</dt><dd>risco-cognitivo.css (verbatim)</dd></div>
				<div><dt>Regras</dt><dd>Apple HIG (ADR-006)</dd></div>
				<div><dt>Contraste</dt><dd>≥ 4,5:1 em 4 modos</dd></div>
			</dl>
		</header>

		<nav class="guia__sumario not-content" aria-label="Seções do guia">
			<p class="guia__sumario-titulo">Sumário</p>
			<ol>
				{secoes.map(([id, nome]) => <li><a href={`#${id}`}>{nome}</a></li>)}
			</ol>
		</nav>

		<!-- 0. Logo -->
		<section id="logo" class="guia__secao not-content" aria-labelledby="logo-titulo">
			<p class="secao-rotulo">Marca</p>
			<h2 id="logo-titulo">Logo</h2>
			<p class="guia__intro">
				"RISCO COGNITIVO" em grotesca pesada, caixa alta, com uma barra azul de acento à esquerda
				(<code>.brand-mark</code>). É texto vivo, não imagem: nítido em qualquer tamanho e com
				claro/escuro automáticos.
			</p>
			<div class="guia__logo-caixas">
				<div class="guia__logo-caixa guia__logo-caixa--clara">
					<span class="brand guia__logo--grande"><span class="brand-mark" aria-hidden="true"></span><span>RISCO COGNITIVO<small>Ideias sob análise</small></span></span>
				</div>
				<div class="guia__logo-caixa guia__logo-caixa--escura">
					<span class="brand guia__logo--grande"><span class="brand-mark" aria-hidden="true"></span><span>RISCO COGNITIVO<small>Ideias sob análise</small></span></span>
				</div>
			</div>
			<div class="guia__grade-3">
				<div>
					<h3>Tamanhos</h3>
					<ul class="guia__lista-chave">
						<li><span class="brand">RISCO COGNITIVO<small>Ideias sob análise</small></span> <code>.brand · cabeçalho (29px)</code></li>
						<li><span class="brand" style="font-size:29px">RISCO COGNITIVO</span> <code>.footer .brand · rodapé</code></li>
					</ul>
				</div>
				<div>
					<h3>Construção</h3>
					<ul class="guia__lista-chave guia__lista-nota">
						<li>Inter 700, caixa alta, entrelinha 0,9, tracking −1,35px</li>
						<li>Barra: 4px × 31px, sem raio, <code>var(--brand)</code></li>
						<li>Respiro entre barra e texto: 11px; área mínima de toque 44px</li>
					</ul>
				</div>
				<div>
					<h3>Ícone (favicon)</h3>
					<div class="guia__favicon">
						<img src="/favicon.svg" alt="" width="64" height="64" />
						<p>"RC" com a mesma barra azul, para aba do navegador e atalhos.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- 1. Cores -->
		<section id="cores" class="guia__secao not-content" aria-labelledby="cores-titulo">
			<p class="secao-rotulo">Fundações</p>
			<h2 id="cores-titulo">Cores</h2>
			<p class="guia__intro">Neutros quentes e um único azul. As amostras usam a variável ao vivo; os valores vêm de <code>cores.css</code>.</p>
			<ul class="guia__cores">
				{
					cores.map((c) => (
						<li>
							<span class="guia__cores-amostra" style={`background: var(--${c.token})`} aria-hidden="true" />
							<strong>{c.nome}</strong>
							<code>--{c.token}</code>
							<span class="guia__cores-papel">{c.papel}</span>
							<span class="guia__cores-valores">
								claro {modos.claro[c.real]} · escuro {modos.escuro[c.real]}
							</span>
						</li>
					))
				}
			</ul>
			<h3 class="guia__subtitulo">Cores semânticas</h3>
			<ul class="guia__semanticas">
				{
					semanticas.map((s) => (
						<li style={`background: var(--${s.fundo}); color: var(--${s.texto})`}>
							{s.nome} <span>--{s.texto} / --{s.fundo}</span>
						</li>
					))
				}
			</ul>
			<h3 class="guia__subtitulo">Pares verificados (Apple HIG, ≥ 4,5:1)</h3>
			<div class="guia__tabela-scroll" tabindex="0" role="region" aria-label="Tabela de contraste">
				<table class="guia__tabela">
					<thead>
						<tr>
							<th scope="col">Texto</th>
							<th scope="col">Fundo</th>
							<th scope="col">Claro</th>
							<th scope="col">Escuro</th>
						</tr>
					</thead>
					<tbody>
						{
							pares.map((p) => (
								<tr>
									<td>--{p.fg}</td>
									<td>--{p.bg}</td>
									<td>{p.claro.toFixed(1)}:1</td>
									<td>{p.escuro.toFixed(1)}:1</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</section>

		<!-- 2. Tipografia -->
		<section id="tipografia" class="guia__secao not-content" aria-labelledby="tipografia-titulo">
			<p class="secao-rotulo">Fundações</p>
			<h2 id="tipografia-titulo">Tipografia</h2>
			<p class="guia__intro">A tipografia é o principal elemento visual: Inter em pesos 400–800, tracking negativo nos títulos, mono para números.</p>
			<ul class="guia__tipos">
				{
					tipos.map((t) => (
						<li>
							<span class="guia__tipos-legenda">
								<strong>{t.nome}</strong>
								<span>{t.uso}</span>
							</span>
							<span class:list={['guia__tipos-exemplo', t.classe]}>{t.exemplo}</span>
						</li>
					))
				}
			</ul>
		</section>

		<!-- 3. Espaço, raio e linhas -->
		<section id="espaco" class="guia__secao not-content" aria-labelledby="espaco-titulo">
			<p class="secao-rotulo">Fundações</p>
			<h2 id="espaco-titulo">Espaço, raio e linhas</h2>
			<p class="guia__intro">Ritmo editorial, não grade de utilitário: <code>--bloco-margem</code> (34px) entre blocos, <code>--bloco-folga</code> (22px) dentro deles. Poucas sombras: nenhuma.</p>
			<div class="guia__grade-3">
				<div>
					<h3>Raio</h3>
					<ul class="guia__raios">
						{
							raios.map((r) => (
								<li>
									<span class="guia__raios-amostra" style={`border-radius: ${r.valor.split(' · ')[1]}`} aria-hidden="true" />
									<span>
										<code>{r.nome}</code>
										{r.valor} · {r.uso}
									</span>
								</li>
							))
						}
					</ul>
				</div>
				<div>
					<h3>Linhas</h3>
					<div class="guia__linhas">
						<div><div class="guia__linha guia__linha--forte" /><code>var(--line-strong)</code> · separa blocos</div>
						<div><div class="guia__linha" /><code>var(--line)</code> · separa itens</div>
						<div><div class="guia__linha guia__linha--azul" /><code>4px azul</code> · pullquote, decisão</div>
					</div>
				</div>
				<div>
					<h3>Foco</h3>
					<p class="guia__foco-nota">Anel de 3px no azul, afastado 2px. Use Tab para ver.</p>
					<span class="guia__foco-demo">Elemento em foco</span>
				</div>
			</div>
		</section>

		<!-- 4. Layout -->
		<section id="layout" class="guia__secao not-content" aria-labelledby="layout-titulo">
			<p class="secao-rotulo">Fundações</p>
			<h2 id="layout-titulo">Layout e breakpoints</h2>
			<p class="guia__intro">Duas larguras e dois pontos de quebra, iguais aos da própria referência. No celular, margem lateral fixa, alvos de 44px e a barra inferior de navegação.</p>
			<div class="guia__grade-2">
				<ul class="guia__lista-chave">
					<li><span>Coluna de leitura</span><code>--container-read · 45rem</code></li>
					<li><span>Página</span><code>var(--max) · 1120px</code></li>
					<li><span>Alvo de toque</span><code>--hit-target · 44px</code></li>
				</ul>
				<ul class="guia__lista-chave">
					<li><span>sm — celular grande</span><code>580px</code></li>
					<li><span>md — nav de seção some, barra inferior assume</span><code>850px</code></li>
				</ul>
			</div>
		</section>

		<!-- 5. Botões -->
		<section id="botoes" class="guia__secao not-content" aria-labelledby="botoes-titulo">
			<p class="secao-rotulo">Componentes</p>
			<h2 id="botoes-titulo">Botões</h2>
			<p class="guia__intro">
				Um botão só, <code>.edit-btn</code>: pílula azul cheia, ícone à esquerda (lápis por padrão, check quando <code>aria-pressed="true"</code>).
				Usado como link ("Perguntar") e como <code>&lt;button&gt;</code> (buscar, salvar, remover). 44px de altura mínima.
			</p>
			<div class="guia__botoes-linha">
				<a class="edit-btn" href="#botoes">Perguntar</a>
				<button type="button" class="edit-btn">Buscar</button>
				<button type="button" class="edit-btn" aria-pressed="true">Salvo</button>
				<button type="button" class="edit-btn" disabled>Desativado</button>
			</div>
			<p class="guia__intro guia__intro--apertado">
				Ação secundária dentro de um bloco (copiar link, salvar), mesma anatomia dos callouts: <code>.acao</code>.
			</p>
			<div class="guia__botoes-linha">
				<button type="button" class="acao"><Icone nome="link" tamanho={16} />Copiar link</button>
				<button type="button" class="acao" aria-pressed="true"><Icone nome="salvos" tamanho={16} />Salvo</button>
			</div>
		</section>

		<!-- 6. Controles -->
		<section id="controles" class="guia__secao not-content" aria-labelledby="controles-titulo">
			<p class="secao-rotulo">Componentes</p>
			<h2 id="controles-titulo">Controles de formulário</h2>
			<p class="guia__intro">Os três controles reais do blog: campo de busca, chip de filtro e segmentado — usados em Buscar, Explorar e Preferências.</p>
			<div class="guia__grade-2">
				<div>
					<h3>Campo de busca</h3>
					<form class="campo-busca" role="search" onsubmit="return false">
						<label class="sr-only" for="guia-busca">Buscar</label>
						<Icone nome="buscar" />
						<input id="guia-busca" type="search" placeholder="Buscar artigos, temas, conceitos…" />
						<button type="submit" class="edit-btn">Buscar</button>
					</form>
				</div>
				<div>
					<h3>Segmentado</h3>
					<div class="segmentado">
						<label><input type="radio" name="guia-seg" checked /><span>Automático</span></label>
						<label><input type="radio" name="guia-seg" /><span>Claro</span></label>
						<label><input type="radio" name="guia-seg" /><span>Escuro</span></label>
					</div>
				</div>
			</div>
			<h3 class="guia__subtitulo">Chips de filtro</h3>
			<div class="opcoes">
				<button type="button" class="filtro-chip" aria-pressed="true">Todos</button>
				<button type="button" class="filtro-chip" aria-pressed="false">P1 · Problemas</button>
				<button type="button" class="filtro-chip" aria-pressed="false">C3 · Decisão</button>
			</div>
		</section>

		<!-- 7. Navegação -->
		<section id="navegacao" class="guia__secao not-content" aria-labelledby="navegacao-titulo">
			<p class="secao-rotulo">Componentes</p>
			<h2 id="navegacao-titulo">Navegação</h2>
			<p class="guia__intro">Marca, trilha, chip de categoria e barra inferior. No celular, as cinco seções ficam sempre visíveis embaixo.</p>
			<div class="guia__grade-2">
				<div class="guia__grade-item">
					<div>
						<h3>Trilha</h3>
						<nav class="crumb trilha" aria-label="Trilha de exemplo"><a href="#navegacao">Blog</a> / <a href="#navegacao">Pessoa e cognição</a></nav>
					</div>
					<div>
						<h3>Chip de categoria</h3>
						<nav class="guia__botoes-linha" aria-label="Categorias de exemplo">
							<a href="#navegacao" class="categoria-chip is-active">Todos</a>
							<a href="#navegacao" class="categoria-chip">Pessoa e cognição</a>
							<a href="#navegacao" class="categoria-chip">Projetos e operações</a>
						</nav>
					</div>
				</div>
				<div>
					<h3>Barra inferior (celular)</h3>
					<div class="guia__barra-mock">
						<div class="guia__barra-mock-tela">conteúdo</div>
						<div class="guia__barra-mock-nav" role="presentation">
							{
								(
									[
										['hoje', 'Hoje'],
										['explorar', 'Explorar'],
										['buscar', 'Buscar'],
										['salvos', 'Salvos'],
										['preferencias', 'Ajustes'],
									] as const
								).map(([icone, nome], i) => (
									<span class:list={['guia__barra-mock-item', { 'is-active': i === 1 }]}>
										<Icone nome={icone} tamanho={22} />
										{nome}
									</span>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 8. Cartões e listas -->
		<section id="cartoes" class="guia__secao not-content" aria-labelledby="cartoes-titulo">
			<p class="secao-rotulo">Componentes</p>
			<h2 id="cartoes-titulo">Cartões e listas</h2>
			<p class="guia__intro">O cartão de artigo (<code>.rc-card</code>) é a única superfície com borda e raio do sistema. Listas preferem filete entre itens.</p>
			<div class="guia__grade-3">
				<div>
					<p class="guia__legenda">Cartão de artigo</p>
					{exemploArtigo && <PostCard artigo={exemploArtigo} />}
