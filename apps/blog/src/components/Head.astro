---
// Override do Head do Starlight: só acrescenta o runtime global dos gráficos (ADR-007).
// Precisa ser global (não escopado a <Grafico>) porque os artigos gerados do vault são .md puro
// (ver docs/07-execucao) e contêm o HTML do gráfico direto, sem importar o componente Astro.
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default><slot /></Default>
<script>
	// Carrega o ECharts só quando o gráfico entra na tela (custo zero em páginas sem gráficos).
	// Reobserva em navegações client-side (astro:page-load) e cobre load normal (chamada direta).
	// Também reage à troca de tema (claro/escuro): sem isso, o gráfico fica com as cores do tema
	// que estava ativo no primeiro render e não acompanha o toggle (StarlightObsidianThemeSelect).
	const graficos = new Map<HTMLElement, import('echarts').ECharts>();

	function iniciar() {
		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				observer.unobserve(entry.target);
				void desenhar(entry.target as HTMLElement);
			}
		});
		document.querySelectorAll<HTMLElement>('[data-grafico]:not([data-pronto])').forEach((el) => observer.observe(el));
	}

	async function desenhar(el: HTMLElement) {
		const echarts = await import('echarts');
		const escuro = document.documentElement.dataset.theme === 'dark';
		const chart = echarts.init(el, escuro ? 'dark' : undefined, { renderer: 'svg' });
		const reduzir = matchMedia('(prefers-reduced-motion: reduce)').matches;
		chart.setOption({
			backgroundColor: 'transparent',
			animation: !reduzir,
			// HIG: a descrição acessível é o título + resumo do autor, não a gerada automaticamente.
			aria: { enabled: true, label: { description: el.dataset.descricao } },
			...JSON.parse(el.dataset.grafico!),
		});
		el.dataset.pronto = 'true';
		graficos.set(el, chart);
		new ResizeObserver(() => chart.resize()).observe(el);
	}

	// Ao trocar de tema, recria (dispose + init) cada gráfico já renderizado com o tema novo do
	// ECharts: setOption sozinho não troca a paleta de cores do tema base de uma instância existente.
	async function retemarizar() {
		if (graficos.size === 0) return;
		const echarts = await import('echarts');
		const escuro = document.documentElement.dataset.theme === 'dark';
		const reduzir = matchMedia('(prefers-reduced-motion: reduce)').matches;
		for (const [el, chartAntigo] of graficos) {
			const opcoes = { ...JSON.parse(el.dataset.grafico!) };
			chartAntigo.dispose();
			const chart = echarts.init(el, escuro ? 'dark' : undefined, { renderer: 'svg' });
			chart.setOption({
				backgroundColor: 'transparent',
				animation: !reduzir,
				aria: { enabled: true, label: { description: el.dataset.descricao } },
				...opcoes,
			});
			graficos.set(el, chart);
		}
	}

	// Diagramas Mermaid (rehype-mermaid, strategy img-svg) saem como <picture> com
	// <source media="(prefers-color-scheme: dark)">: o navegador escolhe pela preferência do
	// SISTEMA e ignora o botão claro/escuro. Aqui a media query vira "all"/"not all" conforme o
	// data-theme escolhido, e o <picture> reavalia a fonte na hora.
	function sincronizarDiagramas() {
		const escuro = document.documentElement.dataset.theme === 'dark';
		document.querySelectorAll<HTMLSourceElement>('picture > source[media*="prefers-color-scheme"], picture > source[data-media-tema]').forEach((s) => {
			s.dataset.mediaTema ??= s.media;
			const paraEscuro = s.dataset.mediaTema!.includes('dark');
			s.media = paraEscuro === escuro ? 'all' : 'not all';
		});
	}

	new MutationObserver(() => {
		sincronizarDiagramas();
		void retemarizar();
	}).observe(document.documentElement, {
		attributes: true,
		attributeFilter: ['data-theme'],
	});

	// Ponte do menu mobile: o botão ☰ do Starlight 0.42 abre o menu pela Popover API nativa
	// (popovertarget="starlight__sidebar"), mas o PageFrame do starlight-theme-obsidian 0.4.1 (última
	// versão) renderiza o painel sem o atributo `popover` e ainda espera o mecanismo antigo
	// (aria-expanded). Resultado: no celular o ☰ não abria nada e o botão claro/escuro, que fica
	// dentro desse menu, ficava inalcançável. Mesmo comportamento do PageFrame padrão do Starlight:
	// popover só abaixo de 50rem. Remover quando o tema publicar versão compatível.
	function ponteMenuMobile() {
		const painel = document.getElementById('starlight__sidebar');
		if (!painel || painel.dataset.ponteMenu) return;
		painel.dataset.ponteMenu = 'true';
		const desktop = matchMedia('(min-width: 50rem)');
		const ajustar = () => {
			if (desktop.matches) {
				if (painel.matches(':popover-open')) painel.hidePopover();
				painel.removeAttribute('popover');
			} else {
				painel.setAttribute('popover', 'auto');
			}
		};
		ajustar();
		desktop.addEventListener('change', ajustar);
		// Ao abrir/fechar: liga o atributo que o tema usa para deslizar o painel para dentro
		// (body[data-mobile-menu-expanded], centered-reading.css) e mantém o foco no menu aberto
		// (mesmo tratamento do Starlight: conteúdo atrás fica inert).
		painel.addEventListener('toggle', (e) => {
			const aberto = (e as ToggleEvent).newState === 'open';
			document.body.toggleAttribute('data-mobile-menu-expanded', aberto);
			document.querySelectorAll<HTMLElement>('.main-frame > :not(.mobile-header), .sl-skip-link').forEach((el) => el.toggleAttribute('inert', aberto));
		});
	}

	ponteMenuMobile();
	sincronizarDiagramas();
	iniciar();
	document.addEventListener('astro:page-load', () => {
		graficos.clear();
		ponteMenuMobile();
		sincronizarDiagramas();
		iniciar();
	});
</script>
