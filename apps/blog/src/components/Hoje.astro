---
// Página "Hoje" (HF01, EXECUTAR Showroom): hero com busca, categorias, destaque e artigos recentes.
import CategoryPill from './CategoryPill.astro';
import Icone from './Icone.astro';
import Ilustracao from './Ilustracao.astro';
import PostCard from './PostCard.astro';
import { artigos, categorias } from '../lib/artigos';

const lista = await artigos();
const cats = await categorias();
const [destaque, ...recentes] = lista;
---

<div class="hoje pagina-larga not-content">
	<section class="hero" aria-labelledby="hoje-titulo">
		<div class="hero-texto">
			<p class="overline">Conhecimento em prática</p>
			<h1 id="hoje-titulo">Riscos cognitivos na execução, explicados com clareza.</h1>
			<p class="hero-resumo">Artigos sobre atenção, processos e o sistema ao redor de quem executa — do problema ao que fazer a respeito.</p>
			<form class="busca" action="/buscar/" method="get" role="search">
				<label class="sr-only" for="hoje-busca">Buscar artigos</label>
				<Icone nome="buscar" />
				<input id="hoje-busca" name="q" type="search" placeholder="Buscar artigos, temas, conceitos…" autocomplete="off" />
				<button type="submit">Buscar</button>
			</form>
		</div>
		<div class="hero-arte">
			<Ilustracao icone="grafico" grande />
		</div>
	</section>

	<nav class="categorias" aria-label="Categorias">
		<a href="/blog/" class="pilula ativa">Todos</a>
		{cats.map((c) => <a href={`/blog/categoria/${c.slug}/`} class="pilula">{c.nome}</a>)}
	</nav>

	{
		destaque && (
			<section aria-labelledby="em-destaque">
				<h2 id="em-destaque" class="rotulo-secao">Em destaque</h2>
				<div class="destaque-grade">
					<PostCard artigo={destaque} destaque />
					<aside class="convite" aria-labelledby="convite-titulo">
						<CategoryPill nome="Pergunte aos artigos" />
						<h3 id="convite-titulo">Tem uma situação concreta?</h3>
						<p>Descreva o que acontece na sua execução e receba uma resposta baseada nos artigos, com as fontes.</p>
						<a class="botao" href="/perguntar/">
							Perguntar <Icone nome="seta" tamanho={16} />
						</a>
					</aside>
				</div>
			</section>
		)
	}

	{
		recentes.length > 0 && (
			<section aria-labelledby="mais-recentes">
				<h2 id="mais-recentes" class="rotulo-secao">Mais recentes</h2>
				<div class="grade">
					{recentes.map((a) => (
						<PostCard artigo={a} />
					))}
				</div>
			</section>
		)
	}
</div>

<style>
	.hero {
		display: grid;
		gap: 2rem;
		align-items: center;
		padding-block: 1.5rem 2.5rem;
	}
	.overline {
		margin: 0 0 0.75rem;
		color: var(--brand-text);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h1 {
		margin: 0;
		color: var(--foreground);
		font-size: clamp(2rem, 5vw, 2.75rem);
		font-weight: 700;
		line-height: 1.12;
		letter-spacing: -0.02em;
	}
	.hero-resumo {
		margin: 1rem 0 1.5rem;
		color: var(--muted);
		font-size: 1.125rem;
		line-height: 1.5;
	}
	.busca {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		max-width: 28rem;
		padding-inline: 1rem 0.375rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		background: var(--surface);
		color: var(--muted);
	}
	.busca:focus-within {
		outline: 2px solid var(--semantic-focus-ring);
		outline-offset: 2px;
	}
	.busca input {
		flex: 1;
		min-width: 0;
		min-height: var(--hit-target);
		border: 0;
		background: transparent;
		color: var(--foreground);
		font: inherit;
		outline: none;
	}
	.busca button,
	.botao {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		min-height: 2.25rem;
		padding-inline: 1rem;
		border: 0;
		border-radius: var(--radius-pill);
		background: var(--accent);
		color: var(--on-accent);
		font-size: 0.9375rem;
		font-weight: 600;
		text-decoration: none;
	}
	.botao {
		min-height: var(--hit-target);
		justify-self: start;
	}
	.categorias {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		padding-block: 0.25rem 0.5rem;
		scrollbar-width: none;
	}
	.pilula {
		display: inline-flex;
		align-items: center;
		flex: none;
		min-height: var(--hit-target);
		padding-inline: 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		background: var(--surface);
		color: var(--foreground);
		font-size: 0.9375rem;
		text-decoration: none;
	}
	.pilula.ativa {
		border-color: var(--foreground);
		background: var(--foreground);
		color: var(--surface);
	}
	.rotulo-secao {
		margin: 2.5rem 0 1rem;
		color: var(--muted);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.destaque-grade,
	.grade {
		display: grid;
		gap: 1rem;
	}
	.convite {
		display: grid;
		gap: 0.75rem;
		align-content: center;
		justify-items: start;
		padding: 1.5rem;
		border: 1px solid var(--brand-line);
		border-radius: var(--radius-xl);
		background: var(--brand-soft);
	}
	.convite h3 {
		margin: 0;
		color: var(--foreground);
		font-size: 1.375rem;
	}
	.convite p {
		margin: 0;
		color: var(--foreground);
	}
	@media (min-width: 48rem) {
		.hero {
			grid-template-columns: 1.1fr 1fr;
		}
		.destaque-grade {
			grid-template-columns: 1.6fr 1fr;
		}
		.grade {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
