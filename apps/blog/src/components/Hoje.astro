---
// Página "Hoje" (HF01; ADR-019): abertura no vocabulário da referência editorial — eyebrow, título,
// deck e busca, com a capa ao lado; categorias em chips; destaque e recentes em cards.
import Icone from './Icone.astro';
import Ilustracao from './Ilustracao.astro';
import PostCard from './PostCard.astro';
import { artigos, categorias } from '../lib/artigos';

const lista = await artigos();
const cats = await categorias();
const [destaque, ...recentes] = lista;
---

<div class="hoje faixa not-content">
	<section class="hero" aria-labelledby="hoje-titulo">
		<figure class="hero-art">
			<Ilustracao icone="grafico" grande />
		</figure>
		<div class="hero-copy">
			<p class="eyebrow">Conhecimento em prática</p>
			<h1 id="hoje-titulo">Riscos cognitivos na execução, explicados com clareza.</h1>
			<p class="deck">Artigos sobre atenção, processos e o sistema ao redor de quem executa — do problema ao que fazer a respeito.</p>
			<form class="busca" action="/buscar/" method="get" role="search">
				<label class="sr-only" for="hoje-busca">Buscar artigos</label>
				<Icone nome="buscar" />
				<input id="hoje-busca" name="q" type="search" placeholder="Buscar artigos, temas, conceitos…" autocomplete="off" />
				<button type="submit" class="edit-btn">Buscar</button>
			</form>
		</div>
	</section>

	<nav class="categorias" aria-label="Categorias">
		<a href="/blog/" class="categoria-chip is-active">Todos</a>
		{cats.map((c) => <a href={`/blog/categoria/${c.slug}/`} class="categoria-chip">{c.nome}</a>)}
	</nav>

	{
		destaque && (
			<section aria-labelledby="em-destaque" class="secao">
				<h2 id="em-destaque" class="secao-rotulo">
					Em destaque
				</h2>
				<div class="destaque-grade">
					<PostCard artigo={destaque} destaque />
					<aside class="convite" aria-labelledby="convite-titulo">
						<p class="label">Pergunte aos artigos</p>
						<p id="convite-titulo">Tem uma situação concreta?</p>
						<a href="/perguntar/" class="edit-btn">
							Perguntar <Icone nome="seta" tamanho={16} />
						</a>
					</aside>
				</div>
			</section>
		)
	}

	{
		recentes.length > 0 && (
			<section aria-labelledby="mais-recentes" class="secao">
				<h2 id="mais-recentes" class="secao-rotulo">
					Mais recentes
				</h2>
				<div class="grade-cards">
					{recentes.map((a) => (
						<PostCard artigo={a} />
					))}
				</div>
			</section>
		)
	}
</div>

<style>
	.hoje {
		padding: 42px 0 88px;
	}
	.hero {
		display: grid;
		gap: 42px;
		align-items: center;
		padding-bottom: 20px;
		border-bottom: 1px solid var(--line);
	}
	/* min-width:auto de item de grid usa o tamanho intrínseco do SVG (viewBox), não o do bloco —
	   sem isto a ilustração força a coluna a ficar mais larga que a viewport no celular. */
	.hero > * {
		min-width: 0;
	}
	.hero-art {
		margin: 0;
	}
	.hero-copy h1 {
		margin: 0 0 25px;
	}
	.busca {
		display: flex;
		align-items: center;
		gap: 10px;
		width: 100%;
		max-width: 26rem;
		min-height: 46px;
		padding-inline: 16px 6px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--soft);
		color: var(--muted);
	}
	.busca:focus-within {
		outline: 3px solid var(--brand);
		outline-offset: 2px;
	}
	.busca input {
		flex: 1;
		min-width: 0;
		min-height: 44px;
		border: 0;
		background: transparent;
		color: var(--ink);
		font: inherit;
		outline: none;
	}
	.categorias {
		display: flex;
		gap: 8px;
		overflow-x: auto;
		padding-block: 24px 8px;
		scrollbar-width: none;
	}
	.secao {
		margin-top: 44px;
		padding-top: 42px;
		border-top: 1px solid var(--line);
	}
	.destaque-grade,
	.grade-cards {
		display: grid;
		gap: 40px 32px;
	}
	.convite {
		display: grid;
		gap: 12px;
		align-content: center;
		justify-items: start;
		padding-top: 22px;
		border-top: 4px solid var(--brand);
	}
	.convite .label {
		margin: 0;
		color: var(--brand);
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	.convite p#convite-titulo {
		margin: 0;
		color: var(--ink);
		font-family: var(--display);
		font-size: 27px;
		font-weight: 700;
		letter-spacing: -0.75px;
	}
	@media (min-width: 48rem) {
		.hero {
			grid-template-columns: 1.05fr 0.95fr;
		}
		.destaque-grade {
			grid-template-columns: 1.6fr 1fr;
		}
		.grade-cards {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
