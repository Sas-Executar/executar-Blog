---
// Página "Hoje" (HF01; ADR-017: componentes do design system): hero com busca, categorias, destaque e artigos recentes.
import CategoryPill from './CategoryPill.astro';
import Icone from './Icone.astro';
import Ilustracao from './Ilustracao.astro';
import PostCard from './PostCard.astro';
import Botao from './ui/Botao.astro';
import Chip from './ui/Chip.astro';
import Rotulo from './ui/Rotulo.astro';
import { artigos, categorias } from '../lib/artigos';

const lista = await artigos();
const cats = await categorias();
const [destaque, ...recentes] = lista;
---

<div class="hoje pagina-larga not-content">
	<section class="hero grid items-center gap-8 border-b border-rule pt-6 pb-12 md:grid-cols-[1.1fr_1fr] md:gap-12" aria-labelledby="hoje-titulo">
		<div>
			<Rotulo>Conhecimento em prática</Rotulo>
			<h1 id="hoje-titulo" class="m-0 font-display text-display font-bold tracking-tighter text-balance text-ink">Riscos cognitivos na execução, explicados com clareza.</h1>
			<p class="mt-5 mb-7 max-w-xl text-lead text-pretty text-muted">Artigos sobre atenção, processos e o sistema ao redor de quem executa — do problema ao que fazer a respeito.</p>
			<form class="campo campo--busca max-w-md" action="/buscar/" method="get" role="search">
				<label class="sr-only" for="hoje-busca">Buscar artigos</label>
				<Icone nome="buscar" />
				<input id="hoje-busca" name="q" type="search" placeholder="Buscar artigos, temas, conceitos…" autocomplete="off" />
				<button type="submit" class="botao">Buscar</button>
			</form>
		</div>
		<div class="hero-arte">
			<Ilustracao icone="grafico" grande />
		</div>
	</section>

	<nav class="categorias -mx-1 flex gap-2 overflow-x-auto px-1 pt-6 pb-2 [scrollbar-width:none]" aria-label="Categorias">
		<Chip href="/blog/" ativo>Todos</Chip>
		{cats.map((c) => <Chip href={`/blog/categoria/${c.slug}/`}>{c.nome}</Chip>)}
	</nav>

	{
		destaque && (
			<section aria-labelledby="em-destaque" class="mt-10">
				<Rotulo como="h2" id="em-destaque">Em destaque</Rotulo>
				<div class="grid gap-8 md:grid-cols-[1.6fr_1fr]">
					<PostCard artigo={destaque} destaque />
					<aside class="convite grid content-center justify-items-start gap-3 border-t-4 border-accent bg-brand-soft p-6 md:p-8" aria-labelledby="convite-titulo">
						<CategoryPill nome="Pergunte aos artigos" />
						<h3 id="convite-titulo" class="m-0 font-display text-title font-bold tracking-tight text-ink">Tem uma situação concreta?</h3>
						<p class="m-0 text-fg">Descreva o que acontece na sua execução e receba uma resposta baseada nos artigos, com as fontes.</p>
						<Botao href="/perguntar/">
							Perguntar <Icone nome="seta" tamanho={16} />
						</Botao>
					</aside>
				</div>
			</section>
		)
	}

	{
		recentes.length > 0 && (
			<section aria-labelledby="mais-recentes" class="mt-14">
				<Rotulo como="h2" id="mais-recentes">Mais recentes</Rotulo>
				<div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
					{recentes.map((a) => (
						<PostCard artigo={a} />
					))}
				</div>
			</section>
		)
	}
</div>
