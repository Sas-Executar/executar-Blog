---
// Autoria e ações do artigo (Showroom): avatar com iniciais, autor e papel, tempo de leitura,
// Copiar link e Salvar (HF02/HF04). Os botões ganham comportamento em scripts/cliente.ts.
import Icone from './Icone.astro';
import type { Artigo } from '../lib/artigos';

interface Props {
	artigo: Artigo;
}
const { artigo } = Astro.props;
const salvo = JSON.stringify({ url: artigo.url, titulo: artigo.titulo, resumo: artigo.resumo, categoria: artigo.categoria, minutos: artigo.minutos });
---

<div class="meta-bar">
	<div class="autor">
		<span class="avatar" aria-hidden="true">{artigo.iniciais}</span>
		<span class="autor-texto">
			<span class="autor-nome">{artigo.autor}</span>
			{artigo.papel && <span class="autor-papel">{artigo.papel}</span>}
		</span>
		<span class="tempo"><Icone nome="relogio" tamanho={16} />{artigo.minutos} min de leitura</span>
	</div>
	<div class="acoes">
		<button type="button" class="acao" data-copiar-link><Icone nome="link" tamanho={16} /><span data-rotulo>Copiar link</span></button>
		<button type="button" class="acao" data-salvar={salvo} aria-pressed="false"><Icone nome="salvos" tamanho={16} /><span data-rotulo>Salvar</span></button>
	</div>
</div>

<style>
	.meta-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		margin-top: 1.25rem;
	}
	.autor {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}
	.avatar {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: var(--radius-full);
		background: var(--brand-soft);
		color: var(--brand-text);
		font-size: 0.875rem;
		font-weight: 600;
	}
	.autor-texto {
		display: grid;
		line-height: 1.3;
	}
	.autor-nome {
		color: var(--foreground);
		font-weight: 600;
		font-size: 0.9375rem;
	}
	.autor-papel,
	.tempo {
		color: var(--muted);
		font-size: 0.875rem;
	}
	.tempo {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}
	.acoes {
		display: flex;
		gap: 0.5rem;
	}
	.acao {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		min-height: var(--hit-target);
		padding-inline: 0.875rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		background: var(--surface);
		color: var(--foreground);
		font-size: 0.875rem;
		font-weight: 500;
	}
	.acao:hover {
		border-color: var(--muted);
	}
	.acao[aria-pressed='true'] {
		border-color: var(--brand-line);
		background: var(--brand-soft);
		color: var(--brand-text);
	}
</style>
