---
// Byline do artigo (ADR-019, .byline da referência): publicação, autoria, data e as ações do leitor
// — Copiar link e Salvar (HF02/HF04), que ganham comportamento em scripts/cliente.ts.
import Icone from './Icone.astro';
import type { Artigo } from '../lib/artigos';

interface Props {
	artigo: Artigo;
}
const { artigo } = Astro.props;
const salvo = JSON.stringify({ url: artigo.url, titulo: artigo.titulo, resumo: artigo.resumo, categoria: artigo.categoria, minutos: artigo.minutos });
const data = artigo.data?.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<div class="byline meta-bar">
	<span>Artigo para <b>Risco Cognitivo</b></span>
	<span>Por {artigo.autor}{artigo.papel && ` · ${artigo.papel}`}</span>
	{data && <time datetime={artigo.data?.toISOString().slice(0, 10)}>{data}</time>}
	<span class="acoes">
		<button type="button" class="acao" data-copiar-link><Icone nome="link" tamanho={16} /><span data-rotulo>Copiar link</span></button>
		<button type="button" class="acao" data-salvar={salvo} aria-pressed="false"><Icone nome="salvos" tamanho={16} /><span data-rotulo>Salvar</span></button>
	</span>
</div>

<style>
	.acoes {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-inline-start: auto;
	}
</style>
