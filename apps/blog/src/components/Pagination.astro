---
// Override oficial da Pagination (ADR-019): "Continue lendo" (HF02) com os próximos artigos na
// ordem editorial, no vocabulário da referência (rótulo de seção + cards).
import PostCard from './PostCard.astro';
import { artigos, eArtigo } from '../lib/artigos';

const { entry } = Astro.locals.starlightRoute;
const lista = eArtigo(entry.id) ? await artigos() : [];
const i = lista.findIndex((a) => a.id === entry.id);
const proximos = i < 0 ? [] : [...lista.slice(i + 1), ...lista.slice(0, i)].slice(0, 3);
---

{
	proximos.length > 0 && (
		<section class="continue not-content" aria-labelledby="continue-lendo">
			<h2 id="continue-lendo" class="secao-rotulo">
				Continue lendo
			</h2>
			<div class="grade-cards">
				{proximos.map((a) => (
					<PostCard artigo={a} />
				))}
			</div>
			<p class="continue-cta">
				Ficou com dúvida? <a href="/perguntar/">Pergunte aos artigos</a>.
			</p>
		</section>
	)
}

<style>
	.continue {
		max-width: var(--max);
		margin: 56px auto 0;
		padding: 44px 0 0;
		border-top: 1px solid var(--line);
	}
	.grade-cards {
		display: grid;
		gap: 40px 32px;
	}
	.continue-cta {
		margin: 40px 0 0;
		color: var(--muted);
	}
	.continue-cta a {
		color: var(--brand);
		font-weight: 600;
		text-decoration-color: var(--brand);
		text-underline-offset: 4px;
	}
	@media (min-width: 48rem) {
		.grade-cards {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
