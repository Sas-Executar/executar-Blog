---
// Override oficial da Pagination (ADR-012/ADR-017): nos artigos vira "Continue lendo" (próximo passo do
// HF02) — os outros artigos na ordem editorial, a partir do seguinte — e o convite para perguntar.
import PostCard from './PostCard.astro';
import { artigos, eArtigo } from '../lib/artigos';

const { entry } = Astro.locals.starlightRoute;
const lista = eArtigo(entry.id) ? await artigos() : [];
const i = lista.findIndex((a) => a.id === entry.id);
const proximos = i < 0 ? [] : [...lista.slice(i + 1), ...lista.slice(0, i)].slice(0, 3);
---

{
	proximos.length > 0 && (
		<section class="continue not-content mt-16 border-t border-rule pt-8" aria-labelledby="continue-lendo">
			<h2 id="continue-lendo" class="rotulo">Continue lendo</h2>
			<div class="grid gap-x-8 gap-y-10 md:grid-cols-3">
				{proximos.map((a) => (
					<PostCard artigo={a} />
				))}
			</div>
			<p class="mt-10 text-muted">
				Ficou com dúvida? <a href="/perguntar/" class="font-semibold text-link">Pergunte aos artigos</a>.
			</p>
		</section>
	)
}
