---
// Botão do design system (ADR-017): receita .botao em @executar/theme/tailwind.css.
// Vira <a> quando recebe href. Alvo ≥ 44 pt em todos os tamanhos.
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'button'>, 'type'> {
	variante?: 'primario' | 'secundario' | 'quieto';
	tamanho?: 'p' | 'm' | 'g';
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	pressionado?: boolean;
}
const { variante = 'primario', tamanho = 'm', href, type = 'button', pressionado, class: classe, ...resto } = Astro.props;
const classes = ['botao', variante !== 'primario' && `botao--${variante}`, tamanho !== 'm' && `botao--${tamanho}`, classe];
---

{
	href ? (
		<a class:list={classes} href={href} {...(resto as HTMLAttributes<'a'>)}>
			<slot />
		</a>
	) : (
		<button class:list={classes} type={type} aria-pressed={pressionado === undefined ? undefined : (String(pressionado) as 'true' | 'false')} {...resto}>
			<slot />
		</button>
	)
}
