---
// Selo (badge/tag) do design system (ADR-017): pílula pequena em caixa alta.
interface Props {
	variante?: 'marca' | 'neutro' | 'sucesso' | 'aviso' | 'erro';
	href?: string;
	class?: string;
}
const { variante = 'marca', href, class: classe } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['selo', variante !== 'marca' && `selo--${variante}`, classe]} href={href}><slot /></Tag>
