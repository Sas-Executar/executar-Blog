---
// Logo "Risco Cognitivo" (ADR-017, docs/03-design/sot/SOT-REF-002-logo-risco-cognitivo.png):
// grotesca pesada em caixa alta, duas linhas, tracking fechado e a barra azul de acento embaixo.
// Texto vivo (não imagem): nítido em qualquer tamanho, legível por leitor de tela, claro/escuro
// automáticos pelos tokens. Tamanhos: p (cabeçalho), m (rodapé), g (guia/mood board).
interface Props {
	href?: string;
	tamanho?: 'p' | 'm' | 'g';
	class?: string;
}
const { href, tamanho = 'p', class: classe } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
	href={href}
	class:list={['logo', `logo--${tamanho}`, classe]}
	role={href ? undefined : 'img'}
	aria-label={href ? 'Risco Cognitivo, página inicial' : 'Risco Cognitivo'}
>
	<span class="logo__texto" aria-hidden="true">Risco<br />Cognitivo</span>
	<span class="logo__barra" aria-hidden="true"></span>
</Tag>
