---
// Chip do design system (ADR-017): link de navegação (href + ativo → aria-current) ou filtro
// (botão + pressionado → aria-pressed). Alvo ≥ 44 pt.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
	href?: string;
	ativo?: boolean;
	pressionado?: boolean;
}
const { href, ativo = false, pressionado, class: classe, ...resto } = Astro.props;
---

{
	href ? (
		<a class:list={['chip', classe]} href={href} aria-current={ativo ? 'page' : undefined}>
			<slot />
		</a>
	) : (
		<button class:list={['chip', classe]} type="button" aria-pressed={pressionado === undefined ? undefined : (String(pressionado) as 'true' | 'false')} {...resto}>
			<slot />
		</button>
	)
}
