---
// Override oficial do PageTitle (ADR-019). Nos artigos, a abertura da referência editorial: trilha,
// capa e texto (eyebrow, título, deck, "Ler o artigo" e tempo de leitura) e a linha de crédito.
// Nas demais páginas: trilha + título + deck. Na página inicial, o título fica com a própria Hoje.
import Ilustracao from './Ilustracao.astro';
import { PILARES, eArtigo, paraArtigo } from '../lib/artigos';

const { entry } = Astro.locals.starlightRoute;
const artigo = eArtigo(entry.id) && entry.id !== 'blog' ? paraArtigo(entry) : undefined;
const inicio = entry.id === 'index' || entry.id === '';
const eyebrow = artigo && [artigo.pilar && PILARES[artigo.pilar], artigo.categoria].filter(Boolean).join(' · ');
---

{
	artigo ? (
		<>
			<div class="crumb trilha">
				<a href="/">Risco Cognitivo</a> &nbsp; / &nbsp;{' '}
				<a href={`/blog/categoria/${artigo.categoriaSlug}/`}>
					<b>{artigo.categoria}</b>
				</a>
			</div>
			<section class="hero artigo-hero" aria-label="Abertura do artigo">
				<figure class="hero-art">
					<Ilustracao icone={artigo.icone} grande />
				</figure>
				<div class="hero-copy">
					<p class="eyebrow">{eyebrow}</p>
					<h1 id="_top">{entry.data.title}</h1>
					{entry.data.description && <p class="deck">{entry.data.description}</p>}
					<div class="hero-bottom">
						<a href="#artigo">Ler o artigo ↓</a>
						<span id="reading-time">{artigo.minutos} min de leitura</span>
					</div>
				</div>
			</section>
			<p class="credit">
				Ilustração editorial Risco Cognitivo. Texto: {artigo.autor}
				{artigo.papel && `, ${artigo.papel}`}.
			</p>
		</>
	) : inicio ? null : (
		<>
			<div class="crumb trilha faixa">
				<a href="/">Risco Cognitivo</a> &nbsp; / &nbsp; <b>{entry.data.title}</b>
			</div>
			<header class="page-head faixa">
				<h1 id="_top">{entry.data.title}</h1>
				{entry.data.description && <p class="deck">{entry.data.description}</p>}
			</header>
		</>
	)
}

<style>
	/* A capa ilustrada ocupa a área da imagem da referência. */
	.hero-art :global(.ilustracao) {
		width: 100%;
		border-radius: 18px;
	}
</style>
