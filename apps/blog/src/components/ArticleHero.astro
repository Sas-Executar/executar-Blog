---
// Override oficial do PageTitle (ADR-017/ADR-018). Nos artigos, abertura na estrutura da referência
// editorial: capa à esquerda e texto à direita (trilha, selo, título, deck, autoria e ações); no
// celular, capa em cima. As propriedades vão para a coluna de leitura (MarkdownContent.astro).
// Na página inicial o título fica com o hero da Hoje; nas demais páginas, título simples.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import CategoryPill from './CategoryPill.astro';
import Ilustracao from './Ilustracao.astro';
import MetaBar from './MetaBar.astro';
import { eArtigo, paraArtigo } from '../lib/artigos';

const { entry } = Astro.locals.starlightRoute;
const artigo = eArtigo(entry.id) && entry.id !== 'blog' ? paraArtigo(entry) : undefined;
const inicio = entry.id === 'index' || entry.id === '';
// Subtítulo = description, exceto quando o próprio texto já a repete (callout de frase-síntese).
const subtitulo = entry.data.description && !(entry.body ?? '').includes(entry.data.description) ? entry.data.description : undefined;
---

{
	artigo ? (
		<header class="artigo-hero mt-2 grid items-center gap-8 border-b border-rule pb-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] md:gap-12">
			<div class="capa">
				<Ilustracao icone={artigo.icone} grande />
			</div>
			<div class="grid justify-items-start gap-3">
				<nav class="trilha" aria-label="Trilha">
					<a href="/blog/">Blog</a>
					<span aria-hidden="true">/</span>
					<a href={`/blog/categoria/${artigo.categoriaSlug}/`}>{artigo.categoria}</a>
				</nav>
				<CategoryPill nome={artigo.categoria} href={`/blog/categoria/${artigo.categoriaSlug}/`} />
				<Default />
				{subtitulo && <p class="m-0 max-w-xl text-lead text-pretty text-muted">{subtitulo}</p>}
				<MetaBar artigo={artigo} />
			</div>
		</header>
	) : inicio ? null : (
		<Default />
	)
}

<style>
	/* O <h1> vem do PageTitle do Starlight (Default): título editorial grande, tinta, sem traço. */
	.artigo-hero :global(h1#_top) {
		margin-top: 0.25rem;
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--text-display);
		font-weight: 700;
		line-height: 1.02;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}
</style>
