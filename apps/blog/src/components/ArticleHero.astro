---
// Override oficial do PageTitle (ADR-010, tela de referência 05): nos artigos, vira um hero
// editorial com grupo, tempo de leitura, título e subtítulo. Nas outras páginas, título simples.
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { entry } = Astro.locals.starlightRoute;
const [raiz, grupoSlug] = entry.id.split('/');
const artigo = raiz === 'artigos' && entry.id.split('/').length > 2;
const grupo = grupoSlug ? grupoSlug.charAt(0).toUpperCase() + grupoSlug.slice(1).replaceAll('-', ' ') : '';
const palavras = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
// Subtítulo = description, exceto quando o próprio texto já a repete (callout de frase-síntese).
const subtitulo = entry.data.description && !(entry.body ?? '').includes(entry.data.description) ? entry.data.description : undefined;
const minutos = Math.max(1, Math.round(palavras / 200));
---

{
	artigo ? (
		<header class="artigo-hero">
			<p class="artigo-meta">
				<span class="artigo-grupo">{grupo}</span>
				<span aria-hidden="true">·</span>
				<span>{minutos} min de leitura</span>
			</p>
			<Default />
			{subtitulo && <p class="artigo-subtitulo">{subtitulo}</p>}
		</header>
	) : (
		<Default />
	)
}

<style>
	.artigo-hero {
		margin-block: 1rem 0.5rem;
	}
	.artigo-meta {
		display: flex;
		gap: 0.5rem;
		margin: 0 0 0.75rem;
		color: var(--muted);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.04em;
	}
	.artigo-grupo {
		text-transform: uppercase;
	}
	.artigo-hero :global(h1) {
		margin-top: 0;
		font-size: clamp(2rem, 6vw, 2.75rem);
		font-weight: 700;
		line-height: 1.12;
		letter-spacing: -0.02em;
	}
	.artigo-subtitulo {
		margin: 0.75rem 0 0;
		color: var(--muted);
		font-size: 1.1875rem;
		line-height: 1.45;
	}
</style>
