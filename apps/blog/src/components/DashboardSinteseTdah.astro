---
/**
 * Dashboard síntese TDAH × Framework 694.
 * Fonte: dashboard_sintese_tdah_694.html fornecido para publicação.
 * Chart.js 4.5.1 mantém tooltip e legenda interativos.
 */
const kpis = [
  { label: 'Evidências', value: '240', detail: '180 quantitativas + 60 qualitativas' },
  { label: 'Suporte direto', value: '28', detail: 'de 694 perguntas' },
  { label: 'Investigar resolvíveis', value: '25', detail: 'já têm evidência específica' },
  { label: 'Sem evidência', value: '182', detail: 'ainda sem lastro na base TDAH' },
];
---

<section class="tdah-dashboard pagina-larga not-content pt-4 pb-8" aria-labelledby="tdah-dashboard-title">
  <header class="mb-8 max-w-4xl">
    <p class="rotulo">Síntese interativa</p>
    <h1 id="tdah-dashboard-title" class="m-0 font-display text-display font-bold tracking-tighter text-balance text-ink">TDAH adulto × Framework de Descoberta</h1>
    <p class="mt-4 mb-0 max-w-3xl text-lead text-pretty text-muted">
      240 evidências cruzadas com 694 perguntas de produto. Interaja com os gráficos:
      passe o cursor ou toque para ver valores e use a legenda para ocultar ou exibir séries.
    </p>
  </header>

  <div class="mb-8 grid grid-cols-2 gap-x-6 gap-y-2 md:grid-cols-4" aria-label="Indicadores principais">
    {kpis.map((k) => (
      <article class="grid content-start gap-1 border-t border-rule pt-4 pb-2">
        <span class="rotulo rotulo--neutro m-0">{k.label}</span>
        <strong class="font-display text-4xl leading-none font-bold tracking-tight text-ink tabular-nums">{k.value}</strong>
        <small class="text-label leading-snug text-muted">{k.detail}</small>
      </article>
    ))}
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <figure class="chart-card m-0 min-w-0 rounded-card border border-rule bg-surface p-5 md:col-span-2">
      <figcaption class="mb-3 grid gap-1">
        <strong class="text-base text-ink">Cobertura das 694 perguntas</strong>
        <span class="text-label text-muted">Presença de evidência na base TDAH.</span>
      </figcaption>
      <div class="relative h-80"><canvas id="tdah-cobertura"></canvas></div>
    </figure>

    <figure class="chart-card m-0 min-w-0 rounded-card border border-rule bg-surface p-5">
      <figcaption class="mb-3 grid gap-1">
        <strong class="text-base text-ink">Evidências quantitativas por tema</strong>
        <span class="text-label text-muted">Principais grupos entre os 180 registros quantitativos.</span>
      </figcaption>
      <div class="relative h-92"><canvas id="tdah-temas"></canvas></div>
    </figure>

    <figure class="chart-card m-0 min-w-0 rounded-card border border-rule bg-surface p-5">
      <figcaption class="mb-3 grid gap-1">
        <strong class="text-base text-ink">Cobertura por decisão</strong>
        <span class="text-label text-muted">AVANÇAR, CORRIGIR, INVESTIGAR e PAUSAR.</span>
      </figcaption>
      <div class="relative h-92"><canvas id="tdah-decisoes"></canvas></div>
    </figure>
  </div>

  <aside class="mt-6 border-t border-rule pt-4 text-small leading-relaxed text-muted">
    <strong class="text-ink">Como ler.</strong> “Suporte direto” indica ao menos uma evidência específica com alta
    similaridade textual; “suporte temático” indica contexto relacionado. O material original
    recomenda revisão manual para scores abaixo de 0,15 e não substitui validação primária das fontes.
  </aside>
</section>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
<script is:inline>
  (() => {
    const ChartJS = window.Chart;
    if (!ChartJS) return;

    const css = getComputedStyle(document.documentElement);
    const text = css.getPropertyValue('--foreground').trim() || '#26262a';
    const muted = css.getPropertyValue('--muted').trim() || '#5d605e';
    const border = css.getPropertyValue('--border').trim() || '#d9d9d2';
    const accent = css.getPropertyValue('--accent').trim() || '#0a66c2';
    const brand = css.getPropertyValue('--brand-text').trim() || '#004182';

    ChartJS.defaults.color = muted;
    ChartJS.defaults.font.family = css.getPropertyValue('--font-sans').trim() || 'system-ui';
    ChartJS.defaults.plugins.legend.labels.usePointStyle = true;

    const common = {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { intersect: false, mode: 'index' },
      plugins: {
        legend: { position: 'bottom' },
        tooltip: { enabled: true }
      }
    };

    new ChartJS(document.getElementById('tdah-cobertura'), {
      type: 'doughnut',
      data: {
        labels: ['Suporte temático', 'Sem evidência', 'Suporte direto'],
        datasets: [{
          data: [484, 182, 28],
          backgroundColor: [accent, border, brand],
          borderWidth: 0
        }]
      },
      options: { ...common, cutout: '68%', plugins: { ...common.plugins, legend: { position: 'bottom' } } }
    });

    new ChartJS(document.getElementById('tdah-temas'), {
      type: 'bar',
      data: {
        labels: [
          'Sintomas e funções executivas',
          'Síntese estratégica',
          'Sintomas nucleares',
          'Parâmetros operacionais',
          'Prejuízo funcional',
          'Funções executivas',
          'Demanda orgânica'
        ],
        datasets: [{
          label: 'Registros',
          data: [91, 23, 18, 13, 10, 10, 5],
          backgroundColor: accent,
          borderRadius: 6
        }]
      },
      options: {
        ...common,
        indexAxis: 'y',
        scales: {
          x: { beginAtZero: true, grid: { color: border } },
          y: { grid: { display: false }, ticks: { color: text } }
        },
        plugins: { ...common.plugins, legend: { display: false } }
      }
    });

    new ChartJS(document.getElementById('tdah-decisoes'), {
      type: 'bar',
      data: {
        labels: ['AVANÇAR', 'CORRIGIR', 'INVESTIGAR', 'PAUSAR'],
        datasets: [
          { label: 'Suporte direto', data: [1, 2, 25, 0], backgroundColor: brand },
          { label: 'Suporte temático', data: [40, 33, 401, 10], backgroundColor: accent },
          { label: 'Sem evidência', data: [28, 24, 128, 2], backgroundColor: border }
        ]
      },
      options: {
        ...common,
        scales: {
          x: { stacked: true, grid: { display: false }, ticks: { color: text } },
          y: { stacked: true, beginAtZero: true, grid: { color: border } }
        }
      }
    });
  })();
</script>
