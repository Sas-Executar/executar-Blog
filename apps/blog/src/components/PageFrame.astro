---
// Override oficial do PageFrame (ADR-019): a moldura é a da referência editorial Risco Cognitivo —
// faixa utilitária, cabeçalho, conteúdo e rodapé — no lugar da moldura de documentação do Starlight.
// No celular, as seções ficam na barra inferior (HIG: 5 alvos de 44 pt sempre visíveis).
import Icone from './Icone.astro';
import { SECOES, secaoAtual } from '../lib/navegacao';

const atual = secaoAtual(Astro.url.pathname);
const rodape = [...SECOES.map((s) => ({ href: s.href, rotulo: s.rotulo })), { href: '/perguntar/', rotulo: 'Pergunte aos artigos' }, { href: '/guia-de-estilo/', rotulo: 'Guia de estilo' }];
---

<div class="utility" id="topo"><span>Percepção · Comportamento · Decisão</span><span>Um olhar além do óbvio</span></div>
<slot name="header" />
<slot />

<footer class="footer rodape-site">
	<div class="footer-inner">
		<div>
			<span class="brand">RISCO COGNITIVO</span>
			<p>Um espaço para examinar como percebemos e decidimos. Um projeto EXECUTAR.</p>
			<nav aria-label="Rodapé">
				<ul class="footer-links">{rodape.map((l) => <li><a href={l.href}>{l.rotulo}</a></li>)}</ul>
			</nav>
		</div>
		<a href="#topo">Voltar ao início ↑</a>
	</div>
</footer>

<nav
	class="barra-inferior fixed inset-x-0 bottom-0 z-30 grid grid-cols-5 border-t border-rule bg-paper/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md md:hidden"
	aria-label="Navegação principal"
>
	{
		SECOES.map((s) => (
			<a
				href={s.href}
				aria-current={atual === s.href ? 'page' : undefined}
				class="grid min-h-14 content-center justify-items-center gap-0.5 text-overline font-semibold tracking-normal text-muted no-underline aria-[current=page]:text-brand-text"
			>
				<Icone nome={s.icone} tamanho={22} />
				<span>{s.rotulo}</span>
			</a>
		))
	}
</nav>

<div id="anuncio" class="sr-only" aria-live="polite"></div>

<script src="../scripts/cliente.ts"></script>
<script>
	// Tema claro/noturno (referência v12): mesma chave do Starlight, então Preferências e o
	// carregamento inicial (ThemeProvider do Starlight) continuam valendo.
	function iniciarTema() {
		const botoes = document.querySelectorAll<HTMLButtonElement>('[data-alternar-tema]');
		const pintar = () => {
			const escuro = document.documentElement.dataset.theme === 'dark';
			botoes.forEach((b) => {
				b.setAttribute('aria-pressed', String(escuro));
				b.setAttribute('aria-label', escuro ? 'Ativar modo claro' : 'Ativar modo noturno');
			});
		};
		botoes.forEach((b) => {
			if (b.dataset.pronto) return;
			b.dataset.pronto = 'true';
			b.addEventListener('click', () => {
				const tema = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = tema;
				try {
					localStorage.setItem('starlight-theme', tema);
				} catch {
					/* armazenamento bloqueado: vale só nesta página */
				}
				pintar();
			});
		});
		pintar();
	}
	iniciarTema();
	document.addEventListener('astro:page-load', iniciarTema);
</script>

<style>
	:global(body) {
		padding-bottom: calc(3.5rem + env(safe-area-inset-bottom));
	}
	@media (min-width: 53.125rem) {
		:global(body) {
			padding-bottom: 0;
		}
	}
</style>
