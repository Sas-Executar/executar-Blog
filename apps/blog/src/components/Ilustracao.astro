---
// Capa ilustrativa dos artigos (ADR-017): cubo azul de marca entre dois cubos neutros, linhas finas
// e um selo de ícone por categoria. Só tokens (claro/escuro automáticos). Decorativa (aria-hidden).
import Icone from './Icone.astro';
import type { Icone as NomeIcone } from '../lib/artigos';

interface Props {
	icone: NomeIcone;
	grande?: boolean;
}
const { icone, grande = false } = Astro.props;
---

<div class:list={['ilustracao relative aspect-video overflow-hidden rounded-card border border-rule-soft bg-surface', { grande }]} aria-hidden="true">
	<svg viewBox="0 0 400 240" preserveAspectRatio="xMidYMid meet" class="size-full">
		<line x1="70" y1="70" x2="170" y2="130" class="traco"></line>
		<line x1="330" y1="70" x2="240" y2="125" class="traco"></line>
		<g transform="translate(110 150)">
			<path d="M0 -38 38 -16 0 6 -38 -16z" class="face topo-neutro"></path>
			<path d="M-38 -16 0 6 0 50 -38 28z" class="face esq-neutro"></path>
			<path d="M38 -16 0 6 0 50 38 28z" class="face dir-neutro"></path>
		</g>
		<g transform="translate(290 150)">
			<path d="M0 -38 38 -16 0 6 -38 -16z" class="face topo-neutro"></path>
			<path d="M-38 -16 0 6 0 50 -38 28z" class="face esq-neutro"></path>
			<path d="M38 -16 0 6 0 50 38 28z" class="face dir-neutro"></path>
		</g>
		<g transform="translate(200 105)">
			<path d="M0 -50 50 -21 0 8 -50 -21z" class="face topo-marca"></path>
			<path d="M-50 -21 0 8 0 66 -50 37z" class="face esq-marca"></path>
			<path d="M50 -21 0 8 0 66 50 37z" class="face dir-marca"></path>
		</g>
	</svg>
	<span class="absolute top-3 right-3 grid size-7 place-items-center rounded-full border border-rule bg-paper text-brand-text"><Icone nome={icone} tamanho={14} /></span>
</div>

<style>
	.traco {
		stroke: var(--brand-line);
		stroke-width: 1.5;
	}
	.face {
		stroke: var(--border);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.topo-neutro {
		fill: var(--surface);
	}
	.esq-neutro {
		fill: var(--code-background);
	}
	.dir-neutro {
		fill: color-mix(in oklab, var(--code-background) 85%, var(--muted));
	}
	.topo-marca,
	.esq-marca,
	.dir-marca {
		stroke: color-mix(in oklab, var(--accent) 70%, var(--ink));
	}
	.topo-marca {
		fill: color-mix(in oklab, var(--accent) 55%, var(--surface));
	}
	.esq-marca {
		fill: var(--accent);
	}
	.dir-marca {
		fill: color-mix(in oklab, var(--accent) 70%, var(--ink));
	}
</style>
