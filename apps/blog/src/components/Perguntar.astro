---
// "Pergunte aos artigos" (ADR-008): Turnstile + POST /api/perguntar. Campo e botão do design system (ADR-017).
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form class="perguntar grid gap-4" data-perguntar>
	<div>
		<label class="campo-rotulo" for="pergunta">Sua pergunta sobre os artigos</label>
		<div class="campo items-start">
			<textarea id="pergunta" name="pergunta" rows="3" minlength="3" maxlength="500" required
				placeholder="Ex.: Como reduzir a troca de tarefas no dia a dia?"></textarea>
		</div>
	</div>
	<div class="cf-turnstile" data-sitekey={siteKey} data-language="pt-BR"></div>
	<button type="submit" class="botao justify-self-start">Perguntar</button>
	<p class="estado m-0 text-small text-muted" role="status" aria-live="polite"></p>
	<div class="resposta border-t border-rule pt-6" hidden>
		<div class="texto whitespace-pre-wrap text-fg"></div>
		<h3 class="rotulo mt-6">Fontes</h3>
		<ul class="fontes lista-editorial"></ul>
	</div>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
	for (const form of document.querySelectorAll<HTMLFormElement>('[data-perguntar]')) {
		const estado = form.querySelector<HTMLElement>('.estado')!;
		const resposta = form.querySelector<HTMLElement>('.resposta')!;
		const botao = form.querySelector('button')!;
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const dados = new FormData(form);
			botao.disabled = true;
			resposta.hidden = true;
			estado.textContent = 'Pensando… o assistente está lendo os artigos.';
			try {
				const res = await fetch('/api/perguntar', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ pergunta: dados.get('pergunta'), token: dados.get('cf-turnstile-response') }),
				});
				const body = await res.json();
				if (!res.ok) throw new Error(body.erro ?? 'erro inesperado');
				form.querySelector('.texto')!.textContent = body.resposta;
				const lista = form.querySelector('.fontes')!;
				lista.replaceChildren(
					...body.fontes.map((f: { titulo: string; url: string }) => {
						const li = document.createElement('li');
						const a = document.createElement('a');
						a.href = f.url;
						a.textContent = f.titulo;
						li.append(a);
						return li;
					}),
				);
				resposta.hidden = false;
				estado.textContent = '';
			} catch (error) {
				estado.textContent = error instanceof Error ? error.message : String(error);
			} finally {
				botao.disabled = false;
				(window as any).turnstile?.reset();
			}
		});
	}
</script>
