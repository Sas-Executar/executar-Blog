---
// "Pergunte aos artigos" (ADR-008): Turnstile + POST /api/perguntar. Campo e botão no vocabulário
// da referência editorial (ADR-019).
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form class="perguntar" data-perguntar>
	<label for="pergunta">Sua pergunta sobre os artigos</label>
	<textarea id="pergunta" name="pergunta" rows="3" minlength="3" maxlength="500" required placeholder="Ex.: Como reduzir a troca de tarefas no dia a dia?"></textarea>
	<div class="cf-turnstile" data-sitekey={siteKey} data-language="pt-BR"></div>
	<button type="submit" class="edit-btn">Perguntar</button>
	<p class="estado" role="status" aria-live="polite"></p>
	<div class="resposta" hidden>
		<div class="texto"></div>
		<p class="secao-rotulo">Fontes</p>
		<ul class="fontes"></ul>
	</div>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
	for (const form of document.querySelectorAll<HTMLFormElement>('[data-perguntar]')) {
		const estado = form.querySelector<HTMLElement>('.estado')!;
		const resposta = form.querySelector<HTMLElement>('.resposta')!;
		const botao = form.querySelector('button')!;
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const dados = new FormData(form);
			botao.disabled = true;
			resposta.hidden = true;
			estado.textContent = 'Pensando… o assistente está lendo os artigos.';
			try {
				const res = await fetch('/api/perguntar', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ pergunta: dados.get('pergunta'), token: dados.get('cf-turnstile-response') }),
				});
				const body = await res.json();
				if (!res.ok) throw new Error(body.erro ?? 'erro inesperado');
				form.querySelector('.texto')!.textContent = body.resposta;
				const lista = form.querySelector('.fontes')!;
				lista.replaceChildren(
					...body.fontes.map((f: { titulo: string; url: string }) => {
						const li = document.createElement('li');
						const a = document.createElement('a');
						a.href = f.url;
						a.textContent = f.titulo;
						li.append(a);
						return li;
					}),
				);
				resposta.hidden = false;
				estado.textContent = '';
			} catch (error) {
				estado.textContent = error instanceof Error ? error.message : String(error);
			} finally {
				botao.disabled = false;
				(window as any).turnstile?.reset();
			}
		});
	}
</script>

<style>
	.perguntar {
		display: grid;
		gap: 16px;
		max-width: 640px;
	}
	.perguntar label {
		display: block;
		margin-bottom: 8px;
		color: var(--ink);
		font-weight: 600;
	}
	.perguntar textarea {
		width: 100%;
		padding: 14px 16px;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--soft);
		color: var(--ink);
		font: inherit;
		resize: vertical;
	}
	.perguntar textarea:focus-visible {
		outline: 3px solid var(--brand);
		outline-offset: 2px;
	}
	.perguntar button {
		justify-self: start;
	}
	.perguntar .estado {
		margin: 0;
		color: var(--muted);
		font-size: 14px;
	}
	.resposta {
		margin-top: 8px;
		padding-top: 24px;
		border-top: 1px solid var(--line);
	}
	.resposta .texto {
		white-space: pre-wrap;
		color: var(--ink);
	}
	.fontes {
		margin: 16px 0 0;
		padding: 0;
		list-style: none;
	}
	.fontes li {
		padding: 12px 0;
		border-bottom: 1px solid var(--line);
	}
	.fontes a {
		color: var(--brand);
	}
</style>
