---
// Grade de artigos com estado vazio (usada em Blog, Categoria e Explorar).
import PostCard from './PostCard.astro';
import type { Artigo } from '../lib/artigos';

interface Props {
	lista: Artigo[];
	vazio?: string;
}
const { lista, vazio = 'Nenhum artigo por aqui ainda.' } = Astro.props;
---

<div class="lista-artigos grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" data-lista>
	{lista.map((a) => <PostCard artigo={a} nivel="h2" />)}
</div>
<div class="vazio" data-vazio hidden={lista.length > 0}>
	<p>{vazio}</p>
	<a href="/explorar/" class="botao botao--quieto -ml-3">Explorar todos os artigos</a>
</div>
