---
// Override oficial do Header (ADR-012/ADR-017): marca, seções principais e tema.
// No celular as seções vão para a barra inferior (Footer.astro); aqui ficam marca e tema.
import ThemeSelect from 'starlight-theme-obsidian/overrides/ThemeSelect.astro';
import Marca from './ui/Marca.astro';
import { SECOES, secaoAtual } from '../lib/navegacao';

const atual = secaoAtual(Astro.url.pathname);
---

<div class="cabecalho mx-auto flex h-full max-w-page items-center justify-between gap-4">
	<Marca href="/" />
	<nav class="hidden gap-1 md:flex" aria-label="Seções">
		{
			SECOES.map((s) => (
				<a
					href={s.href}
					aria-current={atual === s.href ? 'page' : undefined}
					class="inline-flex min-h-11 items-center px-3 text-small font-medium text-muted no-underline transition-colors hover:text-ink aria-[current=page]:font-semibold aria-[current=page]:text-ink aria-[current=page]:shadow-[inset_0_-2px_0_var(--accent)]"
				>
					{s.rotulo}
				</a>
			))
		}
	</nav>
	<div class="flex items-center gap-1">
		<ThemeSelect />
	</div>
</div>
