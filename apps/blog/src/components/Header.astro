---
// Override oficial do Header (ADR-019): cabeçalho da referência — marca com filete azul, seções em
// caixa alta, alternância de tema e a ação principal (Pergunte aos artigos).
import { SECOES, secaoAtual } from '../lib/navegacao';

const atual = secaoAtual(Astro.url.pathname);
---

<header class="header cabecalho">
	<nav class="nav" aria-label="Seções">
		<a class="brand" href="/" aria-label="Risco Cognitivo, página inicial">
			<span class="brand-mark" aria-hidden="true"></span>
			<span>RISCO COGNITIVO<small>Ideias sob análise</small></span>
		</a>
		<div class="nav-links">
			{
				SECOES.map((s) => (
					<a href={s.href} aria-current={atual === s.href ? 'page' : undefined}>
						{s.rotulo}
					</a>
				))
			}
			<button class="theme-toggle theme-toggle--header" type="button" data-alternar-tema aria-pressed="false" aria-label="Ativar modo noturno"></button>
			<a class="edit-btn" href="/perguntar/">Perguntar</a>
		</div>
	</nav>
</header>
