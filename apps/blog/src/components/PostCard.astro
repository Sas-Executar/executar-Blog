---
// Card de artigo (EXECUTAR Showroom): capa ilustrada, categoria, título, resumo e autoria.
// Os data-* alimentam os filtros do Explorar sem nova requisição.
import CategoryPill from './CategoryPill.astro';
import Icone from './Icone.astro';
import Ilustracao from './Ilustracao.astro';
import type { Artigo } from '../lib/artigos';

interface Props {
	artigo: Artigo;
	destaque?: boolean;
	nivel?: 'h2' | 'h3';
}
const { artigo, destaque = false, nivel = 'h3' } = Astro.props;
const Titulo = nivel;
---

<article class:list={['post-card', { destaque }]} data-categoria={artigo.categoriaSlug} data-pilar={artigo.pilar} data-consciencia={artigo.consciencia}>
	<Ilustracao icone={artigo.icone} grande={destaque} />
	<div class="corpo">
		<CategoryPill nome={artigo.categoria} />
		<Titulo class="titulo"><a href={artigo.url}>{artigo.titulo}</a></Titulo>
		<p class="resumo">{artigo.resumo}</p>
		<p class="autoria">
			<span>Por {artigo.autor}</span>
			<span aria-hidden="true">·</span>
			<span class="tempo"><Icone nome="relogio" tamanho={14} />{artigo.minutos} min</span>
		</p>
	</div>
</article>

<style>
	.post-card {
		position: relative;
		display: grid;
		gap: 0.75rem;
		align-content: start;
		padding: 0.75rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-xl);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		transition: box-shadow var(--motion-duration-default) var(--motion-easing-out);
	}
	.post-card:hover {
		box-shadow: var(--shadow-hover);
	}
	.post-card:focus-within {
		outline: 2px solid var(--semantic-focus-ring);
		outline-offset: 2px;
	}
	.corpo {
		display: grid;
		gap: 0.5rem;
		justify-items: start;
		padding: 0 0.25rem 0.25rem;
	}
	.titulo {
		margin: 0;
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.35;
		color: var(--foreground);
	}
	.destaque .titulo {
		font-size: 1.375rem;
	}
	/* O card inteiro é clicável (link esticado), sem aninhar elementos interativos. */
	.titulo a {
		color: inherit;
		text-decoration: none;
	}
	.titulo a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}
	.titulo a:focus-visible {
		outline: none;
	}
	.resumo {
		margin: 0;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.5;
	}
	.autoria {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.375rem;
		margin: 0.25rem 0 0;
		color: var(--muted);
		font-size: 0.8125rem;
	}
	.tempo {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}
</style>
