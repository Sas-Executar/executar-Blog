---
// Card de artigo (ADR-019, .rc-card em integracao.css): capa, categoria, título, resumo e autoria,
// no mesmo vocabulário tipográfico da referência — filete + eyebrow + título + deck. O card inteiro
// é clicável (link esticado). Os data-* alimentam os filtros do Explorar sem nova requisição.
import Icone from './Icone.astro';
import Ilustracao from './Ilustracao.astro';
import type { Artigo } from '../lib/artigos';

interface Props {
	artigo: Artigo;
	destaque?: boolean;
	nivel?: 'h2' | 'h3';
}
const { artigo, destaque = false, nivel = 'h3' } = Astro.props;
const Titulo = nivel;
---

<article class:list={['rc-card post-card', { 'rc-card--destaque': destaque }]} data-categoria={artigo.categoriaSlug} data-pilar={artigo.pilar} data-consciencia={artigo.consciencia}>
	<Ilustracao icone={artigo.icone} grande={destaque} />
	<div class="rc-card__corpo">
		<p class="eyebrow">{artigo.categoria}</p>
		<Titulo class="rc-card__titulo">
			<a href={artigo.url}>{artigo.titulo}</a>
		</Titulo>
		<p class="rc-card__deck">{artigo.resumo}</p>
		<p class="rc-card__meta">
			Por {artigo.autor} · <Icone nome="relogio" tamanho={12} /> {artigo.minutos} min
		</p>
	</div>
</article>
