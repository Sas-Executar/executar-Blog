---
// Gráfico/dashboard com Apache ECharts (ADR-007). HIG: título e resumo obrigatórios, aria ligado.
import type { EChartsOption } from 'echarts';

interface Props {
	titulo: string;
	resumo: string;
	opcoes: EChartsOption;
	altura?: string;
}
const { titulo, resumo, opcoes, altura = '360px' } = Astro.props;
---

<figure class="grafico">
	<figcaption>{titulo}</figcaption>
	<div class="area" style={`height:${altura}`} data-grafico={JSON.stringify(opcoes)} data-descricao={`${titulo}. ${resumo}`} role="img" aria-label={`${titulo}. ${resumo}`}></div>
	<p class="resumo">{resumo}</p>
</figure>

<script>
	// Carrega o ECharts só quando o gráfico entra na tela (custo zero em páginas sem gráficos).
	const observer = new IntersectionObserver(async (entries) => {
		for (const entry of entries) {
			if (!entry.isIntersecting) continue;
			observer.unobserve(entry.target);
			const echarts = await import('echarts');
			const el = entry.target as HTMLElement;
			const escuro = document.documentElement.dataset.theme === 'dark';
			const chart = echarts.init(el, escuro ? 'dark' : undefined, { renderer: 'svg' });
			const reduzir = matchMedia('(prefers-reduced-motion: reduce)').matches;
			chart.setOption({
				backgroundColor: 'transparent',
				animation: !reduzir,
				// HIG: a descrição acessível é o título + resumo do autor, não a gerada automaticamente.
				aria: { enabled: true, label: { description: el.dataset.descricao } },
				...JSON.parse(el.dataset.grafico!),
			});
			el.dataset.pronto = 'true';
			new ResizeObserver(() => chart.resize()).observe(el);
		}
	});
	document.querySelectorAll('[data-grafico]').forEach((el) => observer.observe(el));
</script>

<style>
	.grafico {
		margin-block: 1.5rem;
	}
	figcaption {
		font-weight: 600;
	}
	.resumo {
		color: var(--muted);
	}
</style>
