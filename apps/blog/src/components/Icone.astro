---
// Ícones de traço (24×24, currentColor) usados no shell e nos cards. Sempre decorativos:
// o texto ao lado dá o nome acessível.
interface Props {
	nome: 'hoje' | 'explorar' | 'buscar' | 'salvos' | 'preferencias' | 'grafico' | 'documento' | 'pessoas' | 'cubo' | 'link' | 'relogio' | 'check' | 'seta' | 'fechar';
	tamanho?: number;
}
const { nome, tamanho = 20 } = Astro.props;
const d: Record<Props['nome'], string> = {
	hoje: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z',
	explorar: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zm3.5-12.5-2 5-5 2 2-5z',
	buscar: 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm9 3-4.35-4.35',
	salvos: 'M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z',
	preferencias: 'M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0M16 4v4M10 10v4M18 16v4',
	grafico: 'M4 20V10m6 10V4m6 16v-7m4 7H2',
	documento: 'M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8zm0 0v5h5M9 13h6M9 17h6',
	pessoas: 'M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm-7 10v-1a6 6 0 0 1 12 0v1m2-10a3 3 0 1 0 0-6m6 16v-1a5 5 0 0 0-4-4.9',
	cubo: 'm12 3 8 4.5v9L12 21l-8-4.5v-9zm0 0v18M4 7.5l8 4.5 8-4.5',
	link: 'M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1',
	relogio: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zm0-13v4l3 2',
	check: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zm-4-9 3 3 5-6',
	seta: 'M5 12h14m-6-6 6 6-6 6',
	fechar: 'M6 6l12 12M18 6 6 18',
};
---

<svg class="icone" width={tamanho} height={tamanho} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={d[nome]} /></svg>
