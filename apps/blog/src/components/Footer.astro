---
// Override oficial do Footer (ADR-012/ADR-017): mantém o rodapé do Starlight (inclui "Continue lendo",
// via Pagination) e acrescenta o rodapé do site e a barra inferior do celular.
import Default from '@astrojs/starlight/components/Footer.astro';
import Icone from './Icone.astro';
import Marca from './ui/Marca.astro';
import { SECOES, secaoAtual } from '../lib/navegacao';

const atual = secaoAtual(Astro.url.pathname);
const links = [...SECOES.map((s) => ({ href: s.href, rotulo: s.rotulo })), { href: '/perguntar/', rotulo: 'Pergunte aos artigos' }, { href: '/guia-de-estilo/', rotulo: 'Guia de estilo' }];
---

<Default />

<div class="rodape-site not-content mt-16 grid gap-6 border-t border-rule pt-8 text-small text-muted md:grid-cols-[1fr_auto] md:items-start">
	<div>
		<Marca href="/" tamanho="m" />
		<p class="m-0 mt-3">Riscos cognitivos na execução: conceitos, processos e controles. Um projeto EXECUTAR.</p>
	</div>
	<nav aria-label="Rodapé">
		<ul class="m-0 flex list-none flex-wrap gap-x-4 p-0">
			{
				links.map((l) => (
					<li class="m-0">
						<a href={l.href} class="inline-flex min-h-11 items-center text-muted no-underline hover:text-ink">
							{l.rotulo}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</div>

<nav
	class="barra-inferior fixed inset-x-0 bottom-0 z-(--sl-z-index-navbar) grid grid-cols-5 border-t border-rule bg-paper/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md md:hidden"
	aria-label="Navegação principal"
>
	{
		SECOES.map((s) => (
			<a
				href={s.href}
				aria-current={atual === s.href ? 'page' : undefined}
				class="grid min-h-14 content-center justify-items-center gap-0.5 text-overline font-medium tracking-normal text-muted no-underline aria-[current=page]:font-semibold aria-[current=page]:text-brand-text"
			>
				<Icone nome={s.icone} tamanho={22} />
				<span>{s.rotulo}</span>
			</a>
		))
	}
</nav>

<div id="anuncio" class="sr-only" aria-live="polite"></div>

<script src="../scripts/cliente.ts"></script>

<style>
	:global(body) {
		padding-bottom: calc(3.5rem + env(safe-area-inset-bottom));
	}
	@media (min-width: 53.125rem) {
		:global(body) {
			padding-bottom: 0;
		}
	}
</style>
