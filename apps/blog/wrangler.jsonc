/**
 * Worker do blog (ADR-002): site estático (dist/) servido por Workers Static Assets.
 * Só /api/* executa código (worker/index.ts); o resto é asset grátis no edge.
 */
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "executar-blog",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-21",
	"observability": { "enabled": true },
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*"]
	},
	"services": [{ "binding": "AGENTE", "service": "executar-agente" }],
	"ratelimits": [{ "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
	"secrets": { "required": ["TURNSTILE_SECRET_KEY"] }
}
